//
// Description: CMake configuration for the shape specific ShapeBlock
// definition of a SolverCore element block operator templated on a policy,
// wrapped in the switch statement the operator asks for. The policy
// counterpart of LibUtilities/BasicUtils/Switch/BlockOpShapeBlock.cpp.in,
// configured by ADD_POLICY_ELMT_BLOCK_OPERATOR (cmake/NektarCommon.cmake) in
// the library or solver that defines the policy. The switch code is the one
// MultiRegions generates.
//
///////////////////////////////////////////////////////////////////////////////

// clang-format off
@IMPL_HEADER@

// The switch the @OPERATOR@ @Impl@ implementation asked for, and the macro
// definitions it is built from. Keep the branches here in step with the
// shape specific switch code selected in the function body below.
#if defined(NEKTAR_BLOCKOP_SWITCH_CODE)
#include "LibUtilities/BasicUtils/Switch/SwitchLevel2Defs.h"
#elif defined(NEKTAR_BLOCKOP_SWITCH_1DCOORDS)
#include "LibUtilities/BasicUtils/Switch/SwitchLevel1Defs.h"
#elif defined(NEKTAR_BLOCKOP_SWITCH_PHYSINTERP1D)
#include "LibUtilities/BasicUtils/Switch/SwitchLevel2Defs.h"
#elif defined(NEKTAR_BLOCKOP_SWITCH_PHYSTRACE)
#include "LibUtilities/BasicUtils/Switch/SwitchLevel1Defs.h"
#else
#error "@OPERATOR@ @Impl@ names no switch for its generated ShapeBlock"
#endif

namespace Nektar::SolverCore::detail
{
template <>
template <>
void @OPERATOR@BlockOpImpl<NektarSpaces::@ExecSpace@, MultiRegions::@Impl@,
                           @POLICY_TYPE@, @TData@>::
    ShapeBlock<LibUtilities::@Shape@>(InBlock &inblock, OutBlock &outblock)
{
#define SHAPE_TYPE_@Shape@
#if defined(NEKTAR_BLOCKOP_SWITCH_CODE)
#include "@CMAKE_BINARY_DIR@/library/MultiRegions/include/BlockOpSwitchCode@Shape@.h"
#elif defined(NEKTAR_BLOCKOP_SWITCH_1DCOORDS)
#include "@CMAKE_BINARY_DIR@/library/MultiRegions/include/BlockOpSwitch1DCoordsCode@Shape@.h"
#elif defined(NEKTAR_BLOCKOP_SWITCH_PHYSINTERP1D)
#include "@CMAKE_BINARY_DIR@/library/MultiRegions/include/BlockOpSwitchPhysInterp1D@Shape@.h"
#elif defined(NEKTAR_BLOCKOP_SWITCH_PHYSTRACE)
#include "@CMAKE_BINARY_DIR@/library/MultiRegions/include/BlockOpSwitchPhysTraceExtract@Shape@.h"
#else
#error "@OPERATOR@ @Impl@ names no switch for its generated ShapeBlock"
#endif
}
} // namespace Nektar::SolverCore::detail
