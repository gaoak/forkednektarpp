<NEKTAR xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://www.nektar.info/schema/nektar.xsd">

    <GEOMETRY DIM="2" SPACE="2">
        <VERTEX COMPRESSED="B64Z-LittleEndian" BITSIZE="64">eJxjYMAPGKH098X/geC+Pbo8Exq/zANEPoCrY4bSlrwQcRgNk2fBausHuDwrVnMR8mw49MEAO5o8uj84sOpHmAMAv0cbKwAA</VERTEX>
        <EDGE COMPRESSED="B64Z-LittleEndian" BITSIZE="64">eJx1jssOgDAQAquttj77/3/raQ5Owl4IBBZK+d8ScA3IVfnhTZzcFny7OP4uP/khTu7QHv6e4vy7pNN3h/5HOv2vdPbNsPcDg5gA9QAA</EDGE>
        <ELEMENT>
            <T COMPRESSED="B64Z-LittleEndian" BITSIZE="64">eJx1zbkNACAMA0D+8LP/tjR2gSXSnGwlinPveBgk0wiT7DFnWGSfvcEqdw32zx37Aaf8YV7yx6Tf8MALRtgAzAAA</T>
        </ELEMENT>
        <COMPOSITE>
            <C ID="1"> E[0,9] </C>
            <C ID="2"> E[11,14] </C>
            <C ID="3"> E[8,15] </C>
            <C ID="4"> E[2,6] </C>
            <C ID="5"> T[0-3] </C>
            <C ID="6"> T[4-7] </C>
        </COMPOSITE>
        <DOMAIN>
            <D ID="0"> C[5,6] </D>
        </DOMAIN>
    </GEOMETRY>

    <EXPANSIONS>
        <E COMPOSITE="C[5]" NUMMODES="4" FIELDS="u,v,w" TYPE="MODIFIED" />
        <E COMPOSITE="C[6]" NUMMODES="4" FIELDS="u,v,w" TYPE="MODIFIED" />
    </EXPANSIONS>

    <CONDITIONS>

        <SOLVERINFO>
            <I PROPERTY="GLOBALSYSSOLN"    VALUE="IterativeFull" />
            <I PROPERTY="LinSysIterSolver" VALUE="ConjugateGradientLoc"/>
            <I PROPERTY="Preconditioner"   VALUE="Diagonal"/>
            <I PROPERTY="Projection"       VALUE="Continuous"/>
        </SOLVERINFO>

        <TIMEINTEGRATIONSCHEME>
            <METHOD> BDFImplicit </METHOD>
            <ORDER> 3 </ORDER>
        </TIMEINTEGRATIONSCHEME>

        <PARAMETERS>
            <P> Lambda    = 10 </P>
            <P> IterativeSolverTolerance = 1e-14 </P>
            <P> A = PI </P>
            <P> B = 2*PI </P>
            <P> C = 4*PI </P>
            <P> TimeStep = 1e-4 </P>
        </PARAMETERS>

        <VARIABLES>
            <V ID="0"> u </V>
            <V ID="1"> v </V>
            <V ID="2"> w </V>
        </VARIABLES>

        <BOUNDARYREGIONS>
            <B ID="0"> C[1] </B>
            <B ID="1"> C[2] </B>
            <B ID="2"> C[3] </B>
            <B ID="3"> C[4] </B>
        </BOUNDARYREGIONS>

        <BOUNDARYCONDITIONS>
            <REGION REF="0">
                <D VAR="u" VALUE="sin(A*x)*sin(A*y)" />
                <D VAR="v" VALUE="sin(B*x)*sin(B*y)" />
                <D VAR="w" VALUE="sin(C*x)*sin(C*y)" />
            </REGION>
            <REGION REF="1">
                <N VAR="u" VALUE="A*cos(A*x)*sin(A*y)" />
                <N VAR="v" VALUE="B*cos(B*x)*sin(B*y)" />
                <N VAR="w" VALUE="C*cos(C*x)*sin(C*y)" />
            </REGION>
            <REGION REF="2">
                <D VAR="u" VALUE="sin(A*x)*sin(A*y)" />
                <D VAR="v" VALUE="sin(B*x)*sin(B*y)" />
                <D VAR="w" VALUE="sin(C*x)*sin(C*y)" />
            </REGION>
            <REGION REF="3">
                <N VAR="u" VALUE="A*cos(A*x)*sin(A*y)" />
                <N VAR="v" VALUE="B*cos(B*x)*sin(B*y)" />
                <N VAR="w" VALUE="C*cos(C*x)*sin(C*y)" />
            </REGION>
        </BOUNDARYCONDITIONS>

        <FUNCTION NAME="Forcing">
            <E VAR="u" VALUE="-(Lambda + 2*A*A)*sin(A*x)*sin(A*y)*exp(-t)" />
            <E VAR="v" VALUE="-(Lambda + 2*B*B)*sin(B*x)*sin(B*y)*exp(-2*t)" />
            <E VAR="w" VALUE="-(Lambda + 2*C*C)*sin(C*x)*sin(C*y)*exp(-3*t)" />
        </FUNCTION>

        <FUNCTION NAME="ExactSolution">
            <E VAR="u" VALUE="sin(A*x)*sin(A*y)" />
            <E VAR="v" VALUE="sin(B*x)*sin(B*y)" />
            <E VAR="w" VALUE="sin(C*x)*sin(C*y)" />
        </FUNCTION>

    </CONDITIONS>

</NEKTAR>
