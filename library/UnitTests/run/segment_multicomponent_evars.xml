<?xml version="1.0" encoding="utf-8"?>

<NEKTAR xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://www.nektar.info/schema/nektar.xsd">

    <GEOMETRY DIM="1" SPACE="2">

        <VERTEX>
            <V ID="0"> 0.1 1.0 0.0 </V>
            <V ID="1"> 1.1 1.0 0.0 </V>
            <V ID="2"> 2.0 1.0 0.0 </V>
            <V ID="3"> 3.2 1.0 0.0 </V>
            <V ID="4"> 4.0 1.0 0.0 </V>
            <V ID="5"> 5.0 1.0 0.0 </V>
        </VERTEX>

        <ELEMENT>
            <S ID="0"> 0 1 </S>
            <S ID="1"> 1 2 </S>
            <S ID="2"> 2 3 </S>
            <S ID="3"> 3 4 </S>
            <S ID="4"> 4 5 </S>
        </ELEMENT>

        <COMPOSITE>
            <C ID="0"> S[0-1] </C>
            <C ID="1"> V[0]   </C>
            <C ID="2"> V[5]   </C>
            <C ID="3"> S[2-4] </C>
        </COMPOSITE>

        <DOMAIN> C[0,3] </DOMAIN>
    </GEOMETRY>

    <EXPANSIONS>
        <E COMPOSITE="C[0]" NUMMODES="8" FIELDS="u,v,w" TYPE="MODIFIED" />
        <E COMPOSITE="C[3]" NUMMODES="8" FIELDS="u,v,w" TYPE="MODIFIED" />
    </EXPANSIONS>

    <CONDITIONS>

        <SOLVERINFO>
            <I PROPERTY="GLOBALSYSSOLN"    VALUE="IterativeFull" />
            <I PROPERTY="LinSysIterSolver" VALUE="ConjugateGradientLoc"/>
            <I PROPERTY="Preconditioner"   VALUE="Diagonal"/>
            <I PROPERTY="Projection"       VALUE="Continuous"/>
        </SOLVERINFO>

        <PARAMETERS>
            <P> Lambda    = 10 </P>
            <P> IterativeSolverTolerance = 1e-14 </P>
            <P> A = PI/2 </P>
            <P> B = PI/4 </P>
            <P> C = PI/8 </P>
            <P> TimeStep = 1e-4 </P>
        </PARAMETERS>

        <VARIABLES>
            <V ID="0"> u </V>
            <V ID="1"> v </V>
            <V ID="2"> w </V>
        </VARIABLES>

        <FUNCTION NAME="Forcing">
            <E VAR="u" EVARS="u v w" VALUE="-(Lambda + 3*A*A)*sin(A*x)*exp(-t)+w+v" />
            <E VAR="v" EVARS="u v w" VALUE="-(Lambda + 3*B*B)*sin(B*x)*exp(-2*t)+u+w+v" />
            <E VAR="w" EVARS="u v w" VALUE="-(Lambda + 3*C*C)*sin(C*x)*exp(-3*t)+v+u" />
        </FUNCTION>

    </CONDITIONS>

</NEKTAR>

