<?xml version="1.0" encoding="utf-8" ?>
<NEKTAR xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://www.nektar.info/schema/nektar.xsd">

    <GEOMETRY DIM="3" SPACE="3">
        <VERTEX>
            <V ID="0">0.0 0.0 0.0</V>
            <V ID="1">1.0 0.0 0.0</V>
            <V ID="2">1.0 1.0 0.0</V>
            <V ID="3">0.0 1.0 0.0</V>
            <V ID="4">0.0 0.0 1.0</V>
            <V ID="5">1.0 0.0 1.0</V>
            <V ID="6">1.0 1.0 1.0</V>
            <V ID="7">0.0 1.0 1.0</V>
        </VERTEX>

        <EDGE>
            <E ID="0">0 1</E>
            <E ID="1">1 2</E>
            <E ID="2">2 3</E>
            <E ID="3">3 0</E>
            <E ID="4">0 4</E>
            <E ID="5">1 5</E>
            <E ID="6">2 6</E>
            <E ID="7">3 7</E>
            <E ID="8">4 5</E>
            <E ID="9">5 6</E>
            <E ID="10">6 7</E>
            <E ID="11">7 4</E>
        </EDGE>

        <FACE>
            <Q ID="0">0 1 2 3</Q>
            <Q ID="1">0 5 8 4</Q>
            <Q ID="2">1 6 9 5</Q>
            <Q ID="3">2 7 10 6</Q>
            <Q ID="4">3 4 11 7</Q>
            <Q ID="5">8 9 10 11</Q>
        </FACE>

        <ELEMENT>
            <H ID="0">0 1 2 3 4 5</H>
        </ELEMENT>

        <COMPOSITE>
            <C ID="0">H[0]</C>
            <C ID="1">F[0]</C>
            <C ID="2">F[1]</C>
            <C ID="3">F[2]</C>
            <C ID="4">F[3]</C>
            <C ID="5">F[4]</C>
            <C ID="6">F[5]</C>
        </COMPOSITE>

        <DOMAIN> C[0] </DOMAIN>
    </GEOMETRY>

    <EXPANSIONS>
        <E COMPOSITE="C[0]" NUMMODES="5" TYPE="MODIFIED" FIELDS="u,v,w" />
    </EXPANSIONS>

    <CONDITIONS>
        <SOLVERINFO>
            <I PROPERTY="GLOBALSYSSOLN" VALUE="IterativeFull" />
            <I PROPERTY="LinSysIterSolver" VALUE="ConjugateGradientLoc" />
            <I PROPERTY="Preconditioner" VALUE="Diagonal" />
            <I PROPERTY="Projection" VALUE="Continuous" />
        </SOLVERINFO>

        <TIMEINTEGRATIONSCHEME>
            <METHOD> BDFImplicit </METHOD>
            <ORDER> 3 </ORDER>
        </TIMEINTEGRATIONSCHEME>

        <PARAMETERS>
            <P> Lambda = 1 </P>
            <P> IterativeSolverTolerance = 1e-14 </P>
            <P> A = PI/2 </P>
            <P> B = PI/4 </P>
            <P> C = PI/8 </P>
            <P> TimeStep = 1e-4 </P>
        </PARAMETERS>

        <VARIABLES>
            <V ID="0"> u </V>
            <V ID="1"> v </V>
            <V ID="2"> w </V>
        </VARIABLES>

        <BOUNDARYREGIONS>
            <B ID="0"> C[1] </B>
            <B ID="1"> C[2] </B>
            <B ID="2"> C[3] </B>
            <B ID="3"> C[4] </B>
            <B ID="4"> C[5] </B>
            <B ID="5"> C[6] </B>
        </BOUNDARYREGIONS>

        <BOUNDARYCONDITIONS>
            <REGION REF="0">
                <D VAR="u" VALUE="sin(A*x)*sin(A*y)*sin(A*z)" />
                <D VAR="v" VALUE="sin(B*x)*sin(B*y)*sin(B*z)" />
                <D VAR="w" VALUE="sin(C*x)*sin(C*y)*sin(C*z)" />
            </REGION>
            <REGION REF="1">
                <N VAR="u" VALUE="-sin(A*x)*cos(A*y)*sin(A*z)*A" />
                <N VAR="v" VALUE="-sin(B*x)*cos(B*y)*sin(B*z)*B" />
                <N VAR="w" VALUE="-sin(C*x)*cos(C*y)*sin(C*z)*C" />
            </REGION>
            <REGION REF="2">
                <N VAR="u" VALUE="-sin(A*x)*cos(A*y)*sin(A*z)*A" />
                <N VAR="v" VALUE="-sin(B*x)*cos(B*y)*sin(B*z)*B" />
                <N VAR="w" VALUE="-sin(C*x)*cos(C*y)*sin(C*z)*C" />
            </REGION>
            <REGION REF="3">
                <D VAR="u" VALUE="sin(A*x)*sin(A*y)*sin(A*z)" />
                <D VAR="v" VALUE="sin(B*x)*sin(B*y)*sin(B*z)" />
                <D VAR="w" VALUE="sin(C*x)*sin(C*y)*sin(C*z)" />
            </REGION>
            <REGION REF="4">
                <D VAR="u" VALUE="sin(A*x)*sin(A*y)*sin(A*z)" />
                <D VAR="v" VALUE="sin(B*x)*sin(B*y)*sin(B*z)" />
                <D VAR="w" VALUE="sin(C*x)*sin(C*y)*sin(C*z)" />
            </REGION>
            <REGION REF="5">
                <N VAR="u" VALUE="-sin(A*x)*cos(A*y)*sin(A*z)*A" />
                <N VAR="v" VALUE="-sin(B*x)*cos(B*y)*sin(B*z)*B" />
                <N VAR="w" VALUE="-sin(C*x)*cos(C*y)*sin(C*z)*C" />
            </REGION>
        </BOUNDARYCONDITIONS>

        <FUNCTION NAME="Forcing">
            <E VAR="u" VALUE="-(Lambda + 3*A*A)*sin(A*x)*sin(A*y)*sin(A*z)*exp(-t)" />
            <E VAR="v" VALUE="-(Lambda + 3*B*B)*sin(B*x)*sin(B*y)*sin(B*z)*exp(-2*t)" />
            <E VAR="w" VALUE="-(Lambda + 3*C*C)*sin(C*x)*sin(C*y)*sin(C*z)*exp(-3*t)" />
        </FUNCTION>

        <FUNCTION NAME="ExactSolution">
            <E VAR="u" VALUE="sin(A*x)*sin(A*y)*sin(A*z)" />
            <E VAR="v" VALUE="sin(B*x)*sin(B*y)*sin(B*z)" />
            <E VAR="w" VALUE="sin(C*x)*sin(C*y)*sin(C*z)" />
        </FUNCTION>
    </CONDITIONS>
</NEKTAR>
