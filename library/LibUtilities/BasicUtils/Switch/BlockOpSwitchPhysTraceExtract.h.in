// clang-format off
#if defined(SHAPE_TYPE_Seg)
    const auto nm0 = m_nm[0];
    const auto nq0 = m_nq[0];

    if (m_isDeformed)
    {
        // Default case
#undef OPERATOR_DEF
#define OPERATOR_DEF                                                           \
    OperatorND<LibUtilities::@Shape@, true>(                                   \
        inblock, outblock, NonTemplatedTraceSizeParameter1D(m_nm[0], m_nq[0]));

        // Inner loop case over quarature points Shape dependent
#undef OPERATOR_Q
#define OPERATOR_Q(r, i)                                                       \
    case NQ(i):                                                                \
        OperatorND<LibUtilities::@Shape@, true>(                               \
            inblock, outblock,                                                 \
            TemplatedTraceSizeParameter1D<NM(i), NQ(i)>());                    \
        break;

        // outer loop case over modes
#undef OPERATOR_M
#define OPERATOR_M(r, i)                                                       \
    case NM(i):                                                                \
    {                                                                          \
        switch (nq0)                                                           \
        {                                                                      \
            BOOST_PP_FOR_##r((NM(i), NM(i),                                    \
               BOOST_PP_ADD(BOOST_PP_MUL(@NEKTAR_SWITCH_QMAX_MUL@, NM(i)),     \
                         @NEKTAR_SWITCH_QMAX_ADD@)),                           \
                             LEV2TEST1, LEV2UPDATE1, OPERATOR_Q)               \
            default :                                                          \
            {                                                                  \
                WARNINGL0( m_warnOnceTemplate,                                 \
                           "Executing nq = " + std::to_string(nq0) +           \
                           " non-templated operator");                         \
                m_warnOnceTemplate = true;                                     \
                OPERATOR_DEF                                                   \
            }                                                                  \
            break;                                                             \
        }                                                                      \
    }                                                                          \
    break;

            // templated cases on equi-ordered modes and standard quad usage
            // where quad order goes from mode order to 2(*mode order)
    switch (nm0)
       {
            BOOST_PP_FOR((MIN1D, 0, MAX1D), LEV2TEST, LEV2UPDATE,
                         OPERATOR_M)
       default:
           {                                                            
               WARNINGL0( m_warnOnceTemplate,                           
                           "Executing nm = " + std::to_string(nm0) +
                           " non-templated operator"); 
               m_warnOnceTemplate = true;                               
               OPERATOR_DEF                                        
           }                                                            
           break;
        }
    }
    else
    {
        // Default case
#undef OPERATOR_DEF
#define OPERATOR_DEF                                                           \
    OperatorND<LibUtilities::@Shape@, false>(                                  \
        inblock, outblock, NonTemplatedTraceSizeParameter1D(m_nm[0], m_nq[0]));

        // Inner loop case over quarature points Shape dependent
#undef OPERATOR_Q
#define OPERATOR_Q(r, i)                                                       \
    case NQ(i):                                                                \
        OperatorND<LibUtilities::@Shape@, false>(                              \
            inblock, outblock,                                                 \
            TemplatedTraceSizeParameter1D<NM(i), NQ(i)>());                    \
        break;

        // outer loop case over modes
#undef OPERATOR_M
#define OPERATOR_M(r, i)                                                       \
    case NM(i):                                                                \
    {                                                                          \
        switch (nq0)                                                           \
        {                                                                      \
            BOOST_PP_FOR_##r((NM(i), NM(i),                                    \
               BOOST_PP_ADD(BOOST_PP_MUL(@NEKTAR_SWITCH_QMAX_MUL@, NM(i)),     \
                         @NEKTAR_SWITCH_QMAX_ADD@)),                           \
                             LEV2TEST1, LEV2UPDATE1, OPERATOR_Q)               \
            default :                                                          \
            {                                                                  \
                WARNINGL0( m_warnOnceTemplate,                                 \
                           "Executing nq = " + std::to_string(nq0) +           \
                           " non-templated operator");                         \
                m_warnOnceTemplate = true;                                     \
                OPERATOR_DEF                                                   \
            }                                                                  \
            break;                                                             \
        }                                                                      \
    }                                                                          \
    break;

            // templated cases on equi-ordered modes and standard quad usage
            // where quad order goes from mode order to 2(*mode order)
    switch (nm0)
       {
            BOOST_PP_FOR((MIN1D, 0, MAX1D), LEV2TEST, LEV2UPDATE,
                         OPERATOR_M)
       default:
           {                                                            
               WARNINGL0( m_warnOnceTemplate,                           
                           "Executing nm = " + std::to_string(nm0) +
                           " non-templated operator"); 
               m_warnOnceTemplate = true;                               
               OPERATOR_DEF                                        
           }                                                            
           break;
        }
    }

#elif defined(SHAPE_TYPE_Quad) || defined(SHAPE_TYPE_Tri) || defined(SHAPE_TYPE_NodalTri)
    const auto nm0 = m_nm[0];
    const auto nm1 = m_nm[1];

    const auto nq0 = m_nq[0];
    const auto nq1 = m_nq[1];

    if (m_isDeformed)
    {
        // Default case
#undef OPERATOR_DEF
#define OPERATOR_DEF                                                           \
    OperatorND<LibUtilities::@Shape@, true>(                                   \
        inblock, outblock,                                                     \
        NonTemplatedTraceSizeParameter2D(m_nm[0], m_nm[1], m_nq[0], m_nq[1]));

        // Inner loop case over quarature points Shape dependent
#if defined(SHAPE_TYPE_Quad)
#undef OPERATOR_Q
#define OPERATOR_Q(r, i)                                                       \
    case NQ(i):                                                                \
        OperatorND<LibUtilities::@Shape@, true>(                               \
            inblock, outblock,                                                 \
            TemplatedTraceSizeParameter2D<NM(i), NM(i), NQ(i), NQ(i)>());      \
        break;
#elif defined(SHAPE_TYPE_Tri)|| defined(SHAPE_TYPE_NodalTri)
#undef OPERATOR_Q
#define OPERATOR_Q(r, i)                                                       \
    case NQ(i):                                                                \
        OperatorND<LibUtilities::@Shape@, true>(                               \
            inblock, outblock,                                                 \
            TemplatedTraceSizeParameter2D<NM(i), NM_M1(i), NQ(i), NQ(i)>());   \
        break;
#endif

        // outer loop case over modes
#undef OPERATOR_M
#define OPERATOR_M(r, i)                                                       \
    case NM(i):                                                                \
    {                                                                          \
        switch (nq0)                                                           \
        {                                                                      \
            BOOST_PP_FOR_##r((NM(i), NM(i),                                    \
               BOOST_PP_ADD(BOOST_PP_MUL(@NEKTAR_SWITCH_QMAX_MUL@, NM(i)),     \
                         @NEKTAR_SWITCH_QMAX_ADD@)),                           \
                             LEV2TEST1, LEV2UPDATE1, OPERATOR_Q)               \
            default :                                                          \
            {                                                                  \
                WARNINGL0( m_warnOnceTemplate,                                 \
                           "Executing nq = " + std::to_string(nq0) +           \
                           " non-templated operator");                         \
                m_warnOnceTemplate = true;                                     \
                OPERATOR_DEF                                                   \
            }                                                                  \
            break;                                                             \
        }                                                                      \
    }                                                                          \
    break;

        // templated cases on equi-ordered modes and standard quad
        // usage where quad order goes from mode order to 2(*mode
        // order) Note this will likely not work on cases wtih nquad,
        // nquad+1 distributions
#if defined(SHAPE_TYPE_Quad)
        if ((nm0 == nm1) && (nq0 == nq1))
#elif defined(SHAPE_TYPE_Tri)|| defined(SHAPE_TYPE_NodalTri)
        if ((nm0 == nm1 + 1) && (nq0 == nq1))
#endif
        {
            switch (nm0)
            {
                BOOST_PP_FOR((MIN1D, 0, MAX1D), LEV2TEST, LEV2UPDATE,
                             OPERATOR_M)
                default:
                {                                                       
                    WARNINGL0( m_warnOnceTemplate,                      
                           "Executing nm = " + std::to_string(nm0) +
                           " non-templated operator"); 
                    m_warnOnceTemplate = true;                          
                    OPERATOR_DEF                           
                }                                               
                break;
            }
        }
        else
        {
            WARNINGL0( m_warnOnceTemplate,                              
                           "Executing nm = " + std::to_string(nm0) +
                           " non-templated operator"); 
            m_warnOnceTemplate = true;                                  
            OPERATOR_DEF                                           
        }
    }
    else
    {
        // Default case
#undef OPERATOR_DEF
#define OPERATOR_DEF                                                           \
    OperatorND<LibUtilities::@Shape@, false>(                                  \
        inblock, outblock,                                                     \
        NonTemplatedTraceSizeParameter2D(m_nm[0], m_nm[1], m_nq[0], m_nq[1]));

        // Inner loop case over quarature points Shape dependent
#if defined(SHAPE_TYPE_Quad)
#undef OPERATOR_Q
#define OPERATOR_Q(r, i)                                                       \
    case NQ(i):                                                                \
        OperatorND<LibUtilities::@Shape@, false>(                              \
            inblock, outblock,                                                 \
            TemplatedTraceSizeParameter2D<NM(i), NM(i), NQ(i), NQ(i)>());      \
        break;
#elif defined(SHAPE_TYPE_Tri)|| defined(SHAPE_TYPE_NodalTri)
#undef OPERATOR_Q
#define OPERATOR_Q(r, i)                                                       \
    case NQ(i):                                                                \
        OperatorND<LibUtilities::@Shape@, false>(                              \
            inblock, outblock,                                                 \
            TemplatedTraceSizeParameter2D<NM(i), NM_M1(i), NQ(i), NQ(i)>());   \
        break;
#endif

        // outer loop case over modes
#undef OPERATOR_M
#define OPERATOR_M(r, i)                                                       \
    case NM(i):                                                                \
    {                                                                          \
        switch (nq0)                                                           \
        {                                                                      \
            BOOST_PP_FOR_##r((NM(i), NM(i),                                    \
               BOOST_PP_ADD(BOOST_PP_MUL(@NEKTAR_SWITCH_QMAX_MUL@, NM(i)),     \
                         @NEKTAR_SWITCH_QMAX_ADD@)),                           \
                             LEV2TEST1, LEV2UPDATE1, OPERATOR_Q)               \
            default :                                                          \
            {                                                                  \
                WARNINGL0( m_warnOnceTemplate,                                 \
                           "Executing nq = " + std::to_string(nq0) +           \
                           " non-templated operator");                         \
                m_warnOnceTemplate = true;                                     \
                OPERATOR_DEF                                                   \
            }                                                                  \
            break;                                                             \
        }                                                                      \
    }                                                                          \
    break;

        // templated cases on equi-ordered modes and standard quad
        // usage where quad order goes from mode order to 2(*mode
        // order) Note this will likely not work on cases wtih nquad,
        // nquad+1 distributions
#if defined(SHAPE_TYPE_Quad)
        if ((nm0 == nm1) && (nq0 == nq1))
#elif defined(SHAPE_TYPE_Tri)|| defined(SHAPE_TYPE_NodalTri)
        if ((nm0 == nm1 + 1) && (nq0 == nq1))
#endif
        {
            switch (nm0)
            {
                BOOST_PP_FOR((MIN1D, 0, MAX1D), LEV2TEST, LEV2UPDATE,
                             OPERATOR_M)
                default:
                {                                                       
                    WARNINGL0( m_warnOnceTemplate,                      
                           "Executing nm = " + std::to_string(nm0) +
                           " non-templated operator"); 
                    m_warnOnceTemplate = true;                          
                    OPERATOR_DEF                           
                }                                               
                break;
            }
        }
        else
        {
            WARNINGL0( m_warnOnceTemplate,                              
                           "Executing nm = " + std::to_string(nm0) +
                           " non-templated operator"); 
            m_warnOnceTemplate = true;                                  
            OPERATOR_DEF                                           
        }
    }
#else
    const auto nm0 = m_nm[0];
    const auto nm1 = m_nm[1];
    const auto nm2 = m_nm[2];

    const auto nq00 = m_nq[0];
    const auto nq01 = m_nq[1];
    const auto nq10 = m_nq[2];
    const auto nq11 = m_nq[3];
    const auto nq20 = m_nq[4];
    const auto nq21 = m_nq[5];

    if (m_isDeformed)
    {
        // Default case
#undef OPERATOR_DEF
#define OPERATOR_DEF                                                           \
    OperatorND<LibUtilities::@Shape@, true>(                                   \
        inblock, outblock,                                                     \
        NonTemplatedTraceSizeParameter3D(m_nm[0], m_nm[1], m_nm[2], m_nq[0],   \
                                         m_nq[1], m_nq[2], m_nq[3], m_nq[4],   \
                                         m_nq[5]));

        // Inner loop case over quarature points Shape dependent
#if defined(SHAPE_TYPE_Hex)
#undef OPERATOR_Q
#define OPERATOR_Q(r, i)                                                       \
    case NQ(i):                                                                \
        OperatorND<LibUtilities::@Shape@, true>(                               \
            inblock, outblock,                                                 \
            TemplatedTraceSizeParameter3D<NM(i), NM(i), NM(i), NQ(i),          \
                                          NQ(i), NQ(i), NQ(i), NQ(i),          \
                                          NQ(i)>());                           \
        break;
#elif defined(SHAPE_TYPE_Prism) || defined(SHAPE_TYPE_NodalPrism) ||           \
    defined(SHAPE_TYPE_Pyr)
#undef OPERATOR_Q
#define OPERATOR_Q(r, i)                                                       \
    case NQ(i):                                                                \
        OperatorND<LibUtilities::@Shape@, true>(                               \
            inblock, outblock,                                                 \
            TemplatedTraceSizeParameter3D<NM(i), NM(i), NM_M1(i), NQ(i),       \
                                          NQ_M1(i), NQ(i), NQ_M1(i), NQ(i),    \
                                          NQ(i)>());                           \
        break;
#elif defined(SHAPE_TYPE_Tet) || defined(SHAPE_TYPE_NodalTet)
#undef OPERATOR_Q
#define OPERATOR_Q(r, i)                                                       \
    case NQ(i):                                                                \
        OperatorND<LibUtilities::@Shape@, true>(                               \
            inblock, outblock,                                                 \
            TemplatedTraceSizeParameter3D<NM(i), NM_M1(i), NM_M1(i), NQ(i),    \
                                          NQ_M1(i), NQ(i), NQ_M1(i), NQ(i),    \
                                          NQ_M1(i)>());                        \
        break;
#endif

        // outer loop case over modes
#undef OPERATOR_M
#define OPERATOR_M(r, i)                                                       \
    case NM(i):                                                                \
    {                                                                          \
        switch (nq00)                                                          \
        {                                                                      \
            BOOST_PP_FOR_##r((NM(i), NM(i),                                    \
               BOOST_PP_ADD(BOOST_PP_MUL(@NEKTAR_SWITCH_QMAX_MUL@, NM(i)),     \
                         @NEKTAR_SWITCH_QMAX_ADD@)),                           \
                             LEV2TEST1, LEV2UPDATE1, OPERATOR_Q)               \
            default :                                                          \
            {                                                                  \
                WARNINGL0( m_warnOnceTemplate,                                 \
                           "Executing nq = " + std::to_string(nq00) +          \
                           " non-templated operator");                         \
                m_warnOnceTemplate = true;                                     \
                OPERATOR_DEF                                                   \
            }                                                                  \
            break;                                                             \
        }                                                                      \
    }                                                                          \
    break;

        // templated cases on equi-ordered modes and standard quad usage
        // where quad order goes from mode order to 2(*mode order)
#if defined(SHAPE_TYPE_Hex)
        if ((nm0 == nm1) && (nm1 == nm2) && (nq00 == nq10) && (nq00 == nq20) &&
            (nq00 == nq01) && (nq10 == nq11) && (nq20 == nq21))
#elif defined(SHAPE_TYPE_Prism) || defined(SHAPE_TYPE_NodalPrism) ||           \
    defined(SHAPE_TYPE_Pyr)
        if ((nm0 == nm1) && (nm1 == nm2+1) && (nq00 == nq10) && (nq00 == nq20) &&
            (nq00 == nq01+1) && (nq10 == nq11+1) && (nq20 == nq21))
#elif defined(SHAPE_TYPE_Tet) || defined(SHAPE_TYPE_NodalTet)
        if ((nm0 == nm1+1) && (nm1 == nm2) && (nq00 == nq10) &&
            (nq00 == nq20)  && (nq00 == nq01+1) && (nq10 == nq11+1) &&
            (nq20 == nq21+1))
#endif
        {
            switch (nm0)
            {
                BOOST_PP_FOR((MIN1D, 0, MAX1D), LEV2TEST, LEV2UPDATE,
                             OPERATOR_M)
                default:
                {                                                       
                    WARNINGL0( m_warnOnceTemplate,                      
                           "Executing nm = " + std::to_string(nm0) +
                           " non-templated operator"); 
                    m_warnOnceTemplate = true;                          
                    OPERATOR_DEF                                   
                }                                                       
                break;
            }
        }
        else
        {
            WARNINGL0( m_warnOnceTemplate,                              
                       "Executing - nm = " + std::to_string(nm0) +
                       " non-templated operator"); 
            m_warnOnceTemplate = true;                                  
            OPERATOR_DEF
        }
    }
    else
    {
        // Default case
#undef OPERATOR_DEF
#define OPERATOR_DEF                                                           \
    OperatorND<LibUtilities::@Shape@, false>(                                  \
        inblock, outblock,                                                     \
        NonTemplatedTraceSizeParameter3D(m_nm[0], m_nm[1], m_nm[2], m_nq[0],   \
                                         m_nq[1], m_nq[2], m_nq[3], m_nq[4],   \
                                         m_nq[5]));

        // Inner loop case over quarature points Shape dependent
#if defined(SHAPE_TYPE_Hex)
#undef OPERATOR_Q
#define OPERATOR_Q(r, i)                                                       \
    case NQ(i):                                                                \
        OperatorND<LibUtilities::@Shape@, false>(                              \
            inblock, outblock,                                                 \
            TemplatedTraceSizeParameter3D<NM(i), NM(i), NM(i), NQ(i),          \
                                          NQ(i), NQ(i), NQ(i), NQ(i),          \
                                          NQ(i)>());                           \
        break;
#elif defined(SHAPE_TYPE_Prism) || defined(SHAPE_TYPE_NodalPrism) ||           \
    defined(SHAPE_TYPE_Pyr)
#undef OPERATOR_Q
#define OPERATOR_Q(r, i)                                                       \
    case NQ(i):                                                                \
        OperatorND<LibUtilities::@Shape@, false>(                              \
            inblock, outblock,                                                 \
            TemplatedTraceSizeParameter3D<NM(i), NM(i), NM_M1(i), NQ(i),       \
                                          NQ_M1(i), NQ(i), NQ_M1(i), NQ(i),    \
                                          NQ(i)>());                           \
        break;
#elif defined(SHAPE_TYPE_Tet) || defined(SHAPE_TYPE_NodalTet)
#undef OPERATOR_Q
#define OPERATOR_Q(r, i)                                                       \
    case NQ(i):                                                                \
        OperatorND<LibUtilities::@Shape@, false>(                              \
            inblock, outblock,                                                 \
            TemplatedTraceSizeParameter3D<NM(i), NM_M1(i), NM_M1(i), NQ(i),    \
                                          NQ_M1(i), NQ(i), NQ_M1(i), NQ(i),    \
                                          NQ_M1(i)>());                        \
        break;
#endif

        // outer loop case over modes
#undef OPERATOR_M
#define OPERATOR_M(r, i)                                                       \
    case NM(i):                                                                \
    {                                                                          \
        switch (nq00)                                                          \
        {                                                                      \
            BOOST_PP_FOR_##r((NM(i), NM(i),                                    \
               BOOST_PP_ADD(BOOST_PP_MUL(@NEKTAR_SWITCH_QMAX_MUL@, NM(i)),     \
                         @NEKTAR_SWITCH_QMAX_ADD@)),                           \
                             LEV2TEST1, LEV2UPDATE1, OPERATOR_Q)               \
            default :                                                          \
            {                                                                  \
                WARNINGL0( m_warnOnceTemplate,                                 \
                           "Executing nq = " + std::to_string(nq00) +          \
                           " non-templated operator");                         \
                m_warnOnceTemplate = true;                                     \
                OPERATOR_DEF                                                   \
            }                                                                  \
            break;                                                             \
        }                                                                      \
    }                                                                          \
    break;

        // templated cases on equi-ordered modes and standard quad usage
        // where quad order goes from mode order to 2(*mode order)
#if defined(SHAPE_TYPE_Hex)
        if ((nm0 == nm1) && (nm1 == nm2) && (nq00 == nq10) && (nq00 == nq20) &&
            (nq00 == nq01) && (nq10 == nq11) && (nq20 == nq21))
#elif defined(SHAPE_TYPE_Prism) || defined(SHAPE_TYPE_NodalPrism) ||           \
    defined(SHAPE_TYPE_Pyr)
        if ((nm0 == nm1) && (nm1 == nm2+1) && (nq00 == nq10) && (nq00 == nq20) &&
            (nq00 == nq01+1) && (nq10 == nq11+1) && (nq20 == nq21))
#elif defined(SHAPE_TYPE_Tet) || defined(SHAPE_TYPE_NodalTet)
        if ((nm0 == nm1+1) && (nm1 == nm2) && (nq00 == nq10) &&
            (nq00 == nq20) && (nq00 == nq01+1) && (nq10 == nq11+1) &&
            (nq20 == nq21+1))
#endif
        {
            switch (nm0)
            {
                BOOST_PP_FOR((MIN1D, 0, MAX1D), LEV2TEST, LEV2UPDATE,
                             OPERATOR_M)
                default:
                {                                                       
                    WARNINGL0( m_warnOnceTemplate,                      
                           "Executing nm = " + std::to_string(nm0) +
                           " non-templated operator"); 
                    m_warnOnceTemplate = true;                          
                    OPERATOR_DEF                                   
                }                                                       
                break;
            }
        }
        else
        {
            WARNINGL0( m_warnOnceTemplate,                              
                       "Executing - nm = " + std::to_string(nm0) +
                       " non-templated operator: "
                       + std::to_string(nm0)  + ","
                       + std::to_string(nm1) + ","
                       + std::to_string(nm2) + ","
                       + std::to_string(nq00) + ","
                       + std::to_string(nq01) + ","
                       + std::to_string(nq10) + ","
                       + std::to_string(nq11) + ","
                       + std::to_string(nq20) + ","
                       + std::to_string(nq21)); 
            m_warnOnceTemplate = true;                                  
            OPERATOR_DEF
        }
    }
#endif
