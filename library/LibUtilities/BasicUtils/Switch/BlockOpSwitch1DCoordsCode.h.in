                    WARNINGL0( m_warnOnceTemplate,               
                               "Executing nq = " + std::to_string(nq0) +
                               " non-templated operator");               
                    m_warnOnceTemplate = true;
                    OPERATOR_DEF;                                      
                }                                                  
                break;
            }
        }
// Equal point counts in every direction, as in BlockOpSwitchCode.h.in.
#if !defined(SHAPE_TYPE_Hex)
        else if ((nq0 == nq1) && (nq1 == nq2))
        {
            switch (nq0)
            {
                BOOST_PP_FOR((MIN1D, MAXPLUSONE1D), LEV1TEST,
                             LEV1UPDATE, OPERATOR_E);
            default:
                {
                    WARNINGL0( m_warnOnceTemplate,
                               "Executing nq = " + std::to_string(nq0) +
                               " non-templated operator");
                    m_warnOnceTemplate = true;
                    OPERATOR_DEF;
                }
                break;
            }
        }
#endif
        else
        {
            WARNINGL0( m_warnOnceTemplate,               
                       "Executing nq = " + std::to_string(nq0) +
                       " non-templated operator");               
            m_warnOnceTemplate = true;
            OPERATOR_DEF;                                      
        }
    }
#endif
// clang-format on
