// clang-format off
#if defined(SHAPE_TYPE_Seg)
    const auto nm0 = m_nm[0];
    const auto nq0 = m_nq[0];

    if (m_isDeformed)
    {

        // Default case
#undef OPERATOR_DEF
#define OPERATOR_DEF                                                           \
    OperatorND<LibUtilities::@Shape@, true>(                                   \
        inblock, outblock, NonTemplatedSizeParameter1D(m_nm[0], m_nq[0]));

        // Inner loop case over quarature points Shape dependent
#undef OPERATOR_Q
#define OPERATOR_Q(r, i)                                                       \
    case NQ(i):                                                                \
        OperatorND<LibUtilities::@Shape@, true>(                               \
            inblock, outblock, TemplatedSizeParameter1D<NM(i), NQ(i)>());      \
        break;

        // outer loop case over modes
#undef OPERATOR_M
#define OPERATOR_M(r, i)                                                       \
    case NM(i):                                                                \
    {                                                                          \
        switch (nq0)                                                           \
        {                                                                      \
            BOOST_PP_FOR_##r((NM(i), NM(i),                                    \
               BOOST_PP_ADD(BOOST_PP_MUL(@NEKTAR_SWITCH_QMAX_MUL@, NM(i)),     \
                         @NEKTAR_SWITCH_QMAX_ADD@)),                           \
                             LEV2TEST1, LEV2UPDATE1, OPERATOR_Q)               \
            default :                                                          \
            {                                                                  \
