                m_warnOnceTemplate = true;                                     \
                OPERATOR_DEF                                                   \
            }                                                                  \
            break;                                                             \
        }                                                                      \
    }                                                                          \
    break;

        // templated cases on equi-ordered modes and standard quad
        // usage where quad order goes from mode order to
        // QMAX_MUL(*mode order) + QMAX_ADD
        switch (nm0)
        {
            BOOST_PP_FOR((MIN1D, 0, MAX1D), LEV2TEST, LEV2UPDATE,
                         OPERATOR_M)
            default:
            {
                WARNINGL0( m_warnOnceTemplate,                                 
                           "Executing nm = " + std::to_string(nm0) +
