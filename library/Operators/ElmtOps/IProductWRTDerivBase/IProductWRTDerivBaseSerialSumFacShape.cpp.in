#include "ElmtOps/IProductWRTDerivBase/IProductWRTDerivBaseSerialSumFac.hpp"

// clang-format off
namespace Nektar::Operators::detail
{

template <>
void OperatorIProductWRTDerivBaseImpl<NektarSpaces::Serial, Operators::SumFac,
                                      double>::
    @Shape@Block(const size_t inSize, const size_t dim, const double *&inPtr,
                double *&outPtr,
                std::shared_ptr<Nektar::LocalRegions::Expansion> expPtr,
                const size_t nElmts, const Array<OneD, const double> &m_jac,
                size_t &jac_idx, const Array<OneD, const double> &m_derivFac,
                size_t &df_idx)
{
    IProductWRTDerivBaseSumFac @Shape
        @Kernel(inSize, dim, inPtr, outPtr, expPtr, nElmts, m_jac, jac_idx,
                m_derivFac, df_idx);
}
// clang-format on
} // namespace Nektar::Operators::detail
