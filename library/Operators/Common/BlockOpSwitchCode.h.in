#if defined(SHAPE_TYPE_Quad)
        if ((nmodes0 == nmodes1) && (nquad0 == nquad1))
#elif defined(SHAPE_TYPE_Tri)
        if ((nmodes0 == nmodes1) && (nquad0 == nquad1 + 1))
#endif
        {
            switch (nmodes0)
            {
                BOOST_PP_FOR((MIN1D, 0, MAX1D), LEV2TEST, LEV2UPDATE,
                             OPERATOR_M)
                default:
                    OPERATOR_DEF
                    break;
            }
        }
        else
        {
            OPERATOR_DEF
        }
    }
#else
    const auto expPtr   = this->m_expansionList->GetExp(m_exp_idx);
    auto const Deformed = expPtr->GetMetricInfo()->GetGtype();
    const auto nmodes0  = expPtr->GetBasisNumModes(0);
    const auto nmodes1  = expPtr->GetBasisNumModes(1);
    const auto nmodes2  = expPtr->GetBasisNumModes(2);

    const auto nquad0 = expPtr->GetNumPoints(0);
    const auto nquad1 = expPtr->GetNumPoints(1);
    const auto nquad2 = expPtr->GetNumPoints(2);

    if (Deformed == SpatialDomains::eDeformed)
    {
        // Default case
#undef OPERATOR_DEF
#define OPERATOR_DEF                                               \
    Operator3D<LibUtilities::@Shape@, true>(input, output);

        // Inner loop case over quarature points Shape dependent
#if defined(SHAPE_TYPE_Hex)
#undef OPERATOR_Q
#define OPERATOR_Q(r, i)                                           \
    case NQ(i):                                                                \
        Operator3D<LibUtilities::@Shape@, true, NM(i), NM(i), NM(i), NQ(i),   \
                   NQ(i), NQ(i)>(input, output);                            \
        break;
#elif defined(SHAPE_TYPE_Prism) || defined(SHAPE_TYPE_Pyr)
#undef OPERATOR_Q
#define OPERATOR_Q(r, i)                                           \
    case NQ(i):                                                                \
        Operator3D<LibUtilities::@Shape@, true, NM(i), NM(i), NM(i), NQ(i),   \
                   NQ(i), NQ_M1(i)>(input, output);                            \
        break;
#elif defined(SHAPE_TYPE_Tet)
#undef OPERATOR_Q
#define OPERATOR_Q(r, i)                                           \
    case NQ(i):                                                                \
        Operator3D<LibUtilities::@Shape@, true, NM(i), NM(i), NM(i), NQ(i),   \
                   NQ_M1(i), NQ_M1(i)>(input, output);                         \
        break;
#endif

        // outer loop case over modes
#undef OPERATOR_M
#define OPERATOR_M(r, i)                                           \
    case NM(i):                                                                \
    {                                                                          \
        switch (nquad0)                                                        \
        {                                                                      \
            BOOST_PP_FOR_##r((NM(i), NM_P1(i), BOOST_PP_MUL(2, NM(i))),        \
                             LEV2TEST1, LEV2UPDATE1,                           \
                             OPERATOR_Q) default                   \
                : OPERATOR_DEF break;                              \
        }                                                                      \
    }                                                                          \
    break;

        // templated cases on equi-ordered modes and standard quad usage
        // where quad order goes from mode order to 2(*mode order)
#if defined(SHAPE_TYPE_Hex)
        if ((nmodes0 == nmodes1) && (nmodes1 == nmodes2) &&
            (nquad0 == nquad1) && (nquad1 == nquad2))
#elif defined(SHAPE_TYPE_Prism) || defined(SHAPE_TYPE_Pyr)
        if ((nmodes0 == nmodes1) && (nmodes1 == nmodes2) &&
            (nquad0 == nquad1) && (nquad1 == nquad2 + 1))
#elif defined(SHAPE_TYPE_Tet)
        if ((nmodes0 == nmodes1) && (nmodes1 == nmodes2) &&
            (nquad0 == nquad1 + 1) && (nquad1 == nquad2))
