// clang-format off
#if defined(SHAPE_TYPE_Seg)
const auto expPtr   = this->m_expansionList->GetExp(m_exp_idx);
auto const Deformed = expPtr->GetMetricInfo()->GetGtype();
const auto nq0      = expPtr->GetNumPoints(0);

    if (Deformed == SpatialDomains::eDeformed)
    {
        // Default case
#undef OPERATOR_DEF
#define OPERATOR_DEF                                               \
    Operator1D<LibUtilities::@Shape@, true>(input, output);

        switch (m_coordDim)
        {
        case 1:
        {
#undef OPERATOR
#define OPERATOR(r, i)                                                     \
    case NQ(i):                                                            \
        Operator1D<LibUtilities::eSegment, true, 1, NQ(i)>(input, output); \
        break;
            
            // loop case over quarature points 
            switch (nq0)
            {
                BOOST_PP_FOR((MIN1D, MAX1D), LEV1TEST, LEV1UPDATE, OPERATOR);
            default:
                OPERATOR_DEF;
                break;
            }
        }
        break;
        case 2:
        {
#undef OPERATOR
#define OPERATOR(r, i)                                                         \
    case NQ(i):                                                                \
        Operator1D<LibUtilities::eSegment, true, 2, NQ(i)>(input, output);     \
        break;
            
            // loop case over quarature points 
            switch (nq0)
            {
                BOOST_PP_FOR((MIN1D, MAX1D), LEV1TEST, LEV1UPDATE, OPERATOR);
            default:
                OPERATOR_DEF;
                break;
            }
        }
        break;
        case 3:
        {
#undef OPERATOR
#define OPERATOR(r, i)                                                         \
    case NQ(i):                                                                \
        Operator1D<LibUtilities::eSegment, true, 3, NQ(i)>(input, output);     \
        break;

            // loop case over quarature points 
            switch (nq0)
            {
                BOOST_PP_FOR((MIN1D, MAX1D), LEV1TEST, LEV1UPDATE, OPERATOR);
            default:
                OPERATOR_DEF;
                break;
            }
        }
        break;
        }
    }
    else
    {
        // Default case
#undef OPERATOR_DEF
#define OPERATOR_DEF                                               \
    Operator1D<LibUtilities::@Shape@, false>(input, output);

        switch (m_coordDim)
        {
        case 1:
        {
#undef OPERATOR
#define OPERATOR(r, i)                                                      \
    case NQ(i):                                                             \
        Operator1D<LibUtilities::eSegment, false, 1, NQ(i)>(input, output); \
        break;
            
            // loop case over quarature points 
            switch (nq0)
            {
                BOOST_PP_FOR((MIN1D, MAX1D), LEV1TEST, LEV1UPDATE, OPERATOR);
            default:
                OPERATOR_DEF;
                break;
            }
        }
        break;
        case 2:
        {
#undef OPERATOR
#define OPERATOR(r, i)                                                        \
    case NQ(i):                                                               \
        Operator1D<LibUtilities::eSegment, false, 2, NQ(i)>(input, output);  \
        break;
            
            // loop case over quarature points 
            switch (nq0)
            {
                BOOST_PP_FOR((MIN1D, MAX1D), LEV1TEST, LEV1UPDATE, OPERATOR);
            default:
                OPERATOR_DEF;
                break;
            }
        }
        break;
        case 3:
        {
#undef OPERATOR
#define OPERATOR(r, i)                                                        \
    case NQ(i):                                                               \
        Operator1D<LibUtilities::eSegment, false, 3, NQ(i)>(input, output);   \
        break;

            // loop case over quarature points 
            switch (nq0)
            {
                BOOST_PP_FOR((MIN1D, MAX1D), LEV1TEST, LEV1UPDATE, OPERATOR);
            default:
                OPERATOR_DEF;
                break;
            }
        }
        break;
        }
    }
#elif defined(SHAPE_TYPE_Quad) || defined(SHAPE_TYPE_Tri)

    const auto expPtr   = this->m_expansionList->GetExp(m_exp_idx);
    auto const Deformed = expPtr->GetMetricInfo()->GetGtype();
    const auto nq0      = expPtr->GetNumPoints(0);
    const auto nq1      = expPtr->GetNumPoints(1);

    if (Deformed == SpatialDomains::eDeformed)
    {
        // Default case
#undef OPERATOR_DEF
#define OPERATOR_DEF                                               \
    Operator2D<LibUtilities::@Shape@, true>(input, output);

        switch (m_coordDim)
        {
        case 2:
        {
#undef OPERATOR
#if defined(SHAPE_TYPE_Quad)
#define OPERATOR(r, i)                                                          \
    case NQ(i):                                                                 \
        Operator2D<LibUtilities::Quad, true, 2, NQ(i), NQ(i)>(input, output);   \
        break;
#elif defined(SHAPE_TYPE_Tri)
#define OPERATOR(r, i)                                                          \
    case NQ(i):                                                                 \
        Operator2D<LibUtilities::Tri, true, 2, NQ(i), NQ_M1(i)>(input, output); \
        break;
#endif
            
            // loop case over quarature points 
#if defined(SHAPE_TYPE_Quad)
            if (nq0 == nq1)
#elif defined(SHAPE_TYPE_Tri)
            if (nq0 == nq1 + 1)
#endif
            {
                switch (nq0)
                {
                    BOOST_PP_FOR((MIN1D, MAX1D), LEV1TEST, LEV1UPDATE, OPERATOR);
                default:
                    OPERATOR_DEF;
                    break;
                }
                break;
            }
            else
            {
                OPERATOR_DEF;
            }
        }
        break;
        case 3:
        {
#undef OPERATOR
#if defined(SHAPE_TYPE_Quad)
#define OPERATOR(r, i)                                                          \
    case NQ(i):                                                                 \
        Operator2D<LibUtilities::Quad, true, 3, NQ(i), NQ(i)>(input, output);   \
        break;
#elif defined(SHAPE_TYPE_Tri)
#define OPERATOR(r, i)                                                          \
    case NQ(i):                                                                 \
        Operator2D<LibUtilities::Tri, true, 3, NQ(i), NQ_M1(i)>(input, output); \
        break;
#endif
            
            // loop case over quarature points 
#if defined(SHAPE_TYPE_Quad)
            if (nq0 == nq1)
#elif defined(SHAPE_TYPE_Tri)
            if (nq0 == nq1 + 1)
#endif
            {
                switch (nq0)
                {
                    BOOST_PP_FOR((MIN1D, MAX1D), LEV1TEST, LEV1UPDATE, OPERATOR);
                default:
                    OPERATOR_DEF;
                    break;
                }
                break;
            }
            else
            {
                OPERATOR_DEF;
            }
        }
        break;
        }
    }
    else
    {
        // Default case
#undef OPERATOR_DEF
#define OPERATOR_DEF                                               \
    Operator2D<LibUtilities::@Shape@, false>(input, output);

        switch (m_coordDim)
        {
        case 2:
        {
#undef OPERATOR
#if defined(SHAPE_TYPE_Quad)
#define OPERATOR(r, i)                                                           \
    case NQ(i):                                                                  \
        Operator2D<LibUtilities::Quad, false, 2, NQ(i), NQ(i)>(input, output);   \
        break;
#elif defined(SHAPE_TYPE_Tri)
#define OPERATOR(r, i)                                                           \
    case NQ(i):                                                                  \
        Operator2D<LibUtilities::Tri, false, 2, NQ(i), NQ_M1(i)>(input, output); \
        break;
#endif
            
            // loop case over quarature points 
#if defined(SHAPE_TYPE_Quad)
            if (nq0 == nq1)
#elif defined(SHAPE_TYPE_Tri)
            if (nq0 == nq1 + 1)
#endif
            {
                switch (nq0)
                {
                    BOOST_PP_FOR((MIN1D, MAX1D), LEV1TEST, LEV1UPDATE, OPERATOR);
                default:
                    OPERATOR_DEF;
                    break;
                }
                break;
            }
            else
            {
                OPERATOR_DEF;
            }
        }
        break;
        case 3:
        {
#undef OPERATOR
#if defined(SHAPE_TYPE_Quad)
#define OPERATOR(r, i)                                                           \
    case NQ(i):                                                                  \
        Operator2D<LibUtilities::Quad, false, 3, NQ(i), NQ(i)>(input, output);   \
        break;
#elif defined(SHAPE_TYPE_Tri)
#define OPERATOR(r, i)                                                           \
    case NQ(i):                                                                  \
        Operator2D<LibUtilities::Tri, false, 3, NQ(i), NQ_M1(i)>(input, output); \
        break;
#endif
            
            // loop case over quarature points 
#if defined(SHAPE_TYPE_Quad)
            if (nq0 == nq1)
#elif defined(SHAPE_TYPE_Tri)
            if (nq0 == nq1 + 1)
#endif
            {
                switch (nq0)
                {
                    BOOST_PP_FOR((MIN1D, MAX1D), LEV1TEST, LEV1UPDATE, OPERATOR);
                default:
                    OPERATOR_DEF;
                    break;
                }
                break;
            }
            else
            {
                OPERATOR_DEF;
            }
        }
        break;
        }
    }
#else
    const auto expPtr   = this->m_expansionList->GetExp(m_exp_idx);
    auto const Deformed = expPtr->GetMetricInfo()->GetGtype();
    const auto nq0      = expPtr->GetNumPoints(0);
    const auto nq1      = expPtr->GetNumPoints(1);
    const auto nq2      = expPtr->GetNumPoints(2);

    if (Deformed == SpatialDomains::eDeformed)
    {
        // Default case
#undef OPERATOR_DEF
#define OPERATOR_DEF                                                          \
        Operator3D<LibUtilities::@Shape@, false>(input, output);

#if defined(SHAPE_TYPE_Hex)
#undef OPERATOR
#define OPERATOR(r, i)                                                        \
    case NQ(i):                                                               \
        Operator3D<LibUtilities::@Shape@, true, NQ(i),  NQ(i), NQ(i)>         \
            (input, output);                                                  \
        break;
#elif defined(SHAPE_TYPE_Prism) || defined(SHAPE_TYPE_Pyr)
#undef OPERATOR
#define OPERATOR(r, i)                                                        \
    case NQ(i):                                                               \
        Operator3D<LibUtilities::@Shape@, true, NQ(i),  NQ(i), NQ_M1(i)>      \
            (input, output);                                                  \
        break;
#elif defined(SHAPE_TYPE_Tet)
#undef OPERATOR
#define OPERATOR(r, i)                                                        \
    case NQ(i):                                                               \
        Operator3D<LibUtilities::@Shape@, true, NQ(i),  NQ_M1(i), NQ_M1(i)>   \
            (input, output);                                                  \
        break;
#endif

            // loop case over quarature points 
#if defined(SHAPE_TYPE_Hex)
        if ((nq0 == nq1) && (nq1 == nq2))
#elif defined(SHAPE_TYPE_Prism) || defined(SHAPE_TYPE_Pyr)
        if ((nq0 == nq1) && (nq1 == nq2 + 1))
#elif defined(SHAPE_TYPE_Tet)
        if ((nq0 == nq1 + 1) && (nq1 == nq2))
#endif
        {
            switch (nq0)
            {
                BOOST_PP_FOR((MIN1D, MAX1D), LEV1TEST, LEV1UPDATE, OPERATOR);
            default:
                OPERATOR_DEF;
                break;
            }
        }
        else
        {
            OPERATOR_DEF;
        }
    }
    else
    {
        // Default case
#undef OPERATOR_DEF
#define OPERATOR_DEF                                                          \
        Operator3D<LibUtilities::@Shape@, false>(input, output);

#if defined(SHAPE_TYPE_Hex)
#undef OPERATOR
#define OPERATOR(r, i)                                                        \
    case NQ(i):                                                               \
        Operator3D<LibUtilities::@Shape@, false, NQ(i),  NQ(i), NQ(i)>        \
            (input, output);                                                  \
        break;
#elif defined(SHAPE_TYPE_Prism) || defined(SHAPE_TYPE_Pyr)
#undef OPERATOR
#define OPERATOR(r, i)                                                        \
    case NQ(i):                                                               \
        Operator3D<LibUtilities::@Shape@, false, NQ(i),  NQ(i), NQ_M1(i)>     \
            (input, output);                                                  \
        break;
#elif defined(SHAPE_TYPE_Tet)
#undef OPERATOR
#define OPERATOR(r, i)                                                        \
    case NQ(i):                                                               \
        Operator3D<LibUtilities::@Shape@, false, NQ(i),  NQ_M1(i), NQ_M1(i)>  \
            (input, output);                                                  \
        break;
#endif

            // loop case over quarature points 
#if defined(SHAPE_TYPE_Hex)
        if ((nq0 == nq1) && (nq1 == nq2))
#elif defined(SHAPE_TYPE_Prism) || defined(SHAPE_TYPE_Pyr)
        if ((nq0 == nq1) && (nq1 == nq2 + 1))
#elif defined(SHAPE_TYPE_Tet)
        if ((nq0 == nq1 + 1) && (nq1 == nq2))
#endif
        {
            switch (nq0)
            {
                BOOST_PP_FOR((MIN1D, MAX1D), LEV1TEST, LEV1UPDATE, OPERATOR);
            default:
                OPERATOR_DEF;
                break;
            }
        }
        else
        {
            OPERATOR_DEF;
        }
    }
#endif
// clang-format on
