<?xml version="1.0" encoding="utf-8"?>

<NEKTAR xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://www.nektar.info/schema/nektar.xsd">

    <GEOMETRY DIM="1" SPACE="1">
        <VERTEX>
            <V ID="0">  0.0  0.0  0.0</V>
            <V ID="1">  0.1  0.0  0.0</V>
            <V ID="2">  0.2  0.0  0.0</V>
            <V ID="3">  0.3  0.0  0.0</V>
            <V ID="4">  0.4  0.0  0.0</V>
            <V ID="5">  0.5  0.0  0.0</V>
            <V ID="6">  0.6  0.0  0.0</V>
            <V ID="7">  0.7  0.0  0.0</V>
            <V ID="8">  0.8  0.0  0.0</V>
            <V ID="9">  0.9  0.0  0.0</V>
            <V ID="10"> 1.0  0.0  0.0</V>
        </VERTEX>

        <ELEMENT>
            <S ID="0">    0     1 </S>
            <S ID="1">    1     2 </S>
            <S ID="2">    2     3 </S>
            <S ID="3">    3     4 </S>
            <S ID="4">    4     5 </S>
            <S ID="5">    5     6 </S>
            <S ID="6">    6     7 </S>
            <S ID="7">    7     8 </S>
            <S ID="8">    8     9 </S>
            <S ID="9">    9    10 </S>
        </ELEMENT>

        <COMPOSITE>
            <C ID="0"> S[0-9] </C>
            <C ID="1"> V[0]   </C>
            <C ID="2"> V[10]  </C>
        </COMPOSITE>

        <DOMAIN> C[0] </DOMAIN>
    </GEOMETRY>

    <EXPANSIONS>
        <E COMPOSITE="C[0]" NUMMODES="8" FIELDS="u" TYPE="MODIFIED" />
    </EXPANSIONS>

    <CONDITIONS>
        <PARAMETERS>
            <P> TimeStep       = 0.001              </P>
            <P> NumSteps       = 100                </P>
            <P> FinTime        = NumSteps*TimeStep  </P>
            <P> IO_InfoSteps   = 1000               </P>
            <P> advx           = 1.0                </P>
        </PARAMETERS>

        <SOLVERINFO>
            <I PROPERTY="EQTYPE"               VALUE="UnsteadyAdvection" />
            <I PROPERTY="Projection"           VALUE="Continuous" />
            <I PROPERTY="AdvectionType"        VALUE="NonConservative" />
            <I PROPERTY="AdvectionAdvancement" VALUE="Explicit" />
        </SOLVERINFO>

        <TIMEINTEGRATIONSCHEME>
            <METHOD> RungeKutta </METHOD>
            <ORDER> 4 </ORDER>
        </TIMEINTEGRATIONSCHEME>

        <VARIABLES>
            <V ID="0"> u </V>
        </VARIABLES>

        <BOUNDARYREGIONS>
            <B ID="0"> C[1] </B>
            <B ID="1"> C[2] </B>
        </BOUNDARYREGIONS>

        <BOUNDARYCONDITIONS>
            <REGION REF="0">
                <D VAR="u" USERDEFINEDTYPE="TimeDependent" VALUE="x-advx*t" />
            </REGION>
            <REGION REF="1">
                <D VAR="u" USERDEFINEDTYPE="TimeDependent" VALUE="x-advx*t" />
            </REGION>
        </BOUNDARYCONDITIONS>

        <FUNCTION NAME="AdvectionVelocity">
            <E VAR="Vx" VALUE="advx" />
        </FUNCTION>

        <FUNCTION NAME="ExactSolution">
            <E VAR="u" VALUE="x-advx*t" />
        </FUNCTION>

        <FUNCTION NAME="InitialConditions">
            <E VAR="u" VALUE="x" />
        </FUNCTION>
    </CONDITIONS>

</NEKTAR>
