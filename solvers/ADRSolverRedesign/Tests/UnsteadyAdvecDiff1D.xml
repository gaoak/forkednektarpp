<?xml version="1.0" encoding="utf-8"?>

<NEKTAR xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://www.nektar.info/schema/nektar.xsd">

    <GEOMETRY DIM="1" SPACE="1">
        <VERTEX>
            <V ID="0">  0.0  0.0  0.0</V>
            <V ID="1">  0.1  0.0  0.0</V>
            <V ID="2">  0.2  0.0  0.0</V>
            <V ID="3">  0.3  0.0  0.0</V>
            <V ID="4">  0.4  0.0  0.0</V>
            <V ID="5">  0.5  0.0  0.0</V>
            <V ID="6">  0.6  0.0  0.0</V>
            <V ID="7">  0.7  0.0  0.0</V>
            <V ID="8">  0.8  0.0  0.0</V>
            <V ID="9">  0.9  0.0  0.0</V>
            <V ID="10"> 1.0  0.0  0.0</V>
        </VERTEX>

        <ELEMENT>
            <S ID="0">    0     1 </S>
            <S ID="1">    1     2 </S>
            <S ID="2">    2     3 </S>
            <S ID="3">    3     4 </S>
            <S ID="4">    4     5 </S>
            <S ID="5">    5     6 </S>
            <S ID="6">    6     7 </S>
            <S ID="7">    7     8 </S>
            <S ID="8">    8     9 </S>
            <S ID="9">    9    10 </S>
        </ELEMENT>

        <COMPOSITE>
            <C ID="0"> S[0-4] </C>
            <C ID="3"> S[5-9] </C>
            <C ID="1"> V[0]   </C>
            <C ID="2"> V[10]  </C>
        </COMPOSITE>

        <DOMAIN> C[0,3] </DOMAIN>
    </GEOMETRY>

    <EXPANSIONS>
        <E COMPOSITE="C[0,3]" NUMMODES="8" FIELDS="u" TYPE="MODIFIED" />
    </EXPANSIONS>

    <FORCING>
        <FORCE TYPE="Body">
            <BODYFORCE> BodyForce </BODYFORCE>
        </FORCE>
    </FORCING>

    <CONDITIONS>
        <PARAMETERS>
            <P> TimeStep       = 0.0001             </P>
            <P> NumSteps       = 100                </P>
            <P> FinTime        = NumSteps*TimeStep  </P>
            <P> epsilon        = 0.5                </P>
            <P> advx           = 0.5                </P>
            <P> A              = PI                </P>
        </PARAMETERS>

        <TIMEINTEGRATIONSCHEME>
            <METHOD> IMEX </METHOD>
            <ORDER> 2 </ORDER>
        </TIMEINTEGRATIONSCHEME>

        <SOLVERINFO>
            <I PROPERTY="EQTYPE"                VALUE="UnsteadyAdvectionDiffusion" />
            <I PROPERTY="Projection"            VALUE="Continuous" />
            <I PROPERTY="GLOBALSYSSOLN"         VALUE="IterativeFull" />
            <I PROPERTY="Preconditioner"        VALUE="Diagonal" />
            <I PROPERTY="LinSysIterSolver"      VALUE="GMRES" />
            <I PROPERTY="DiffusionAdvancement"  VALUE="Implicit" />
            <I PROPERTY="AdvectionAdvancement"  VALUE="Explicit" />
        </SOLVERINFO>

        <VARIABLES>
            <V ID="0"> u </V>
        </VARIABLES>

        <BOUNDARYREGIONS>
            <B ID="0"> C[1] </B>
            <B ID="1"> C[2] </B>
        </BOUNDARYREGIONS>

        <BOUNDARYCONDITIONS>
            <REGION REF="0">
                <D VAR="u" VALUE="sin(A*x)" />
            </REGION>
            <REGION REF="1">
                <D VAR="u" VALUE="sin(A*x)" />
            </REGION>
        </BOUNDARYCONDITIONS>

        <FUNCTION NAME="ExactSolution">
            <E VAR="u" VALUE="sin(A*x)*exp(-t)" />
        </FUNCTION>

        <FUNCTION NAME="InitialConditions">
            <E VAR="u" VALUE="sin(A*x)" />
        </FUNCTION>

        <FUNCTION NAME="BodyForce">
            <E VAR="u" VALUE="advx*A*cos(A*x)*exp(-t) + (A*A*epsilon-1)*sin(A*x)*exp(-t)" />
        </FUNCTION>

        <FUNCTION NAME="AdvectionVelocity">
            <E VAR="Vx" VALUE="advx" />
        </FUNCTION>
    </CONDITIONS>

</NEKTAR>
