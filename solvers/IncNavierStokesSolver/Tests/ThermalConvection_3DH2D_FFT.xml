<?xml version="1.0" encoding="utf-8" ?>
<NEKTAR xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://www.nektar.info/schema/nektar.xsd">
    <GEOMETRY DIM="1" SPACE="1">

        <VERTEX>
            <V ID="0"> 0.00 0.0 0.0 </V>
            <V ID="1"> 0.20 0.0 0.0 </V>
            <V ID="2"> 0.50 0.0 0.0 </V>
            <V ID="3"> 0.80 0.0 0.0 </V>
            <V ID="4"> 1.00 0.0 0.0 </V>
        </VERTEX>

        <ELEMENT>
            <S ID="0"> 0 1 </S>
            <S ID="1"> 1 2 </S>
            <S ID="2"> 2 3 </S>
            <S ID="3"> 3 4 </S>
        </ELEMENT>

        <COMPOSITE>
            <C ID="0"> S[0-3] </C>
            <C ID="1"> V[0] </C>
            <C ID="2"> V[4] </C>
        </COMPOSITE>

        <DOMAIN> C[0] </DOMAIN>

    </GEOMETRY>

    <EXPANSIONS>
        <E COMPOSITE="C[0]" NUMMODES="4" FIELDS="u,v,w,theta,p"
            TYPE="MODIFIED" />
    </EXPANSIONS>

    <CONDITIONS>

        <SOLVERINFO>
            <I PROPERTY="SolverType" VALUE="VelocityCorrectionScheme" />
            <I PROPERTY="EQTYPE" VALUE="UnsteadyNavierStokes" />
            <I PROPERTY="AdvectionForm" VALUE="Convective" />
            <I PROPERTY="Projection" VALUE="Galerkin" />
            <I PROPERTY="EvolutionOperator" VALUE="Nonlinear" />
            <I PROPERTY="HOMOGENEOUS" VALUE="2D" />
            <I PROPERTY="USEFFT" VALUE="FFTW" />
        </SOLVERINFO>

        <TIMEINTEGRATIONSCHEME>
            <METHOD> IMEX </METHOD>
            <ORDER> 2 </ORDER>
        </TIMEINTEGRATIONSCHEME>

        <PARAMETERS>
            <P> TimeStep              = 0.001 </P>
            <P> NumSteps              = 10    </P>
            <P> IO_InfoSteps          = 10    </P>

            <P> HomModesY             = 4     </P>
            <P> LY                    = 2.0   </P>
            <P> HomModesZ             = 4     </P>
            <P> LZ                    = 2.0   </P>

            <P> Ra                    = 10000 </P>
            <P> Pr                    = 0.025 </P>
            <P> Kinvis                = Pr    </P>
            <P> ThermalDiffusivity    = 1.0   </P>
            <P> numConvectiveFields   = 4     </P>
            <P> PerturbationAmplitude = 0.001 </P>
        </PARAMETERS>

        <VARIABLES>
            <V ID="0"> u </V>
            <V ID="1"> v </V>
            <V ID="2"> w </V>
            <V ID="3"> theta </V>
            <V ID="4"> p </V>
        </VARIABLES>

        <BOUNDARYREGIONS>
            <B ID="0"> C[1] </B>
            <B ID="1"> C[2] </B>
        </BOUNDARYREGIONS>

        <BOUNDARYCONDITIONS>
            <REGION REF="0">
                <D VAR="u" VALUE="0" />
                <D VAR="v" VALUE="0" />
                <D VAR="w" VALUE="0" />
                <D VAR="theta" VALUE="1" />
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0" />
            </REGION>
            <REGION REF="1">
                <D VAR="u" VALUE="0" />
                <D VAR="v" VALUE="0" />
                <D VAR="w" VALUE="0" />
                <D VAR="theta" VALUE="0" />
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0" />
            </REGION>
        </BOUNDARYCONDITIONS>

        <FUNCTION NAME="InitialConditions">
            <E VAR="u" VALUE="0" />
            <E VAR="v" VALUE="0" />
            <E VAR="w" VALUE="0" />
            <E VAR="theta"
                VALUE="1-x+PerturbationAmplitude*sin(PI*x)*(cos(2*PI*y/LY)+cos(2*PI*z/LZ))" />
            <E VAR="p" VALUE="Ra*Pr*(x-0.5*x*x)" />
        </FUNCTION>

        <FUNCTION NAME="DiffusionCoefficient">
            <E VAR="theta" VALUE="ThermalDiffusivity" />
        </FUNCTION>

        <FUNCTION NAME="BodyForce">
            <E VAR="u" VALUE="Ra*Pr*theta" EVARS="u v w theta" />
            <E VAR="v" VALUE="0" EVARS="u v w theta" />
            <E VAR="w" VALUE="0" EVARS="u v w theta" />
            <E VAR="theta" VALUE="0" EVARS="u v w theta" />
        </FUNCTION>

    </CONDITIONS>

    <FORCING>
        <FORCE TYPE="Body">
            <BODYFORCE> BodyForce </BODYFORCE>
        </FORCE>
    </FORCING>

</NEKTAR>
