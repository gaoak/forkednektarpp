<?xml version='1.0' encoding='utf-8'?>
<NEKTAR>
    <EXPANSIONS>
        <E COMPOSITE="C[0]" NUMMODES="5" NUMPOINTS="7" TYPE="MODIFIED" FIELDS="u,v,w,phi" />
        <E COMPOSITE="C[0]" NUMMODES="4" NUMPOINTS="7" TYPE="MODIFIED" FIELDS="p" />
    </EXPANSIONS>
    <CONDITIONS>
        <SOLVERINFO>
            <I PROPERTY="EQType" VALUE="UnsteadyNavierStokes" />
            <I PROPERTY="SolverType" VALUE="VelocityCorrectionScheme" />
            <I PROPERTY="Projection" VALUE="Continuous" />
            <I PROPERTY="Homogeneous" VALUE="1D" />
            <I PROPERTY="ElectricPotential" VALUE="Internal" />
        </SOLVERINFO>
        <TIMEINTEGRATIONSCHEME>
            <METHOD>IMEX</METHOD>
            <ORDER>1</ORDER>
        </TIMEINTEGRATIONSCHEME>
        <PARAMETERS>
            <P> Kinvis = 0.1 </P>
            <P> TimeStep = 0.02 </P>
            <P> NumSteps = 500 </P>
            <P> IO_InfoSteps = 100 </P>
            <P> HomModesZ = 2 </P>
            <P> LZ = 1 </P>
            <P> Flowrate = 0.1 </P>
            <P> IO_FlowSteps = 100 </P>
            <P> IO_FlowStepsPrecision = 12 </P>
            <P> Ha = 1 </P>
            <P> HalfWidth = 0.5 </P>
            <P> ElectricConductivity = 1 </P>
            <P> MagneticFieldStrength = Ha/HalfWidth*sqrt(Kinvis/ElectricConductivity) </P>
            <P> WallConductanceRatio = 0.05 </P>
            <P> WallLength = WallConductanceRatio*HalfWidth </P>
        </PARAMETERS>
        <VARIABLES>
            <V ID="0"> u </V>
            <V ID="1"> v </V>
            <V ID="2"> w </V>
            <V ID="3"> phi </V>
            <V ID="4"> p </V>
        </VARIABLES>
        <BOUNDARYREGIONS>
            <B ID="0"> C[10] </B>
            <B ID="1"> C[11] </B>
            <B ID="2"> C[12] </B>
            <B ID="3"> C[13] </B>
        </BOUNDARYREGIONS>
        <BOUNDARYCONDITIONS>
            <REGION REF="0">
                <D VAR="u" VALUE="0" />
                <D VAR="v" VALUE="0" />
                <D VAR="w" VALUE="0" />
                <R VAR="phi" VALUE="0" USERDEFINEDTYPE="ThinConductingWall" PRIMCOEFF="WallLength" />
                <N VAR="p" VALUE="0" USERDEFINEDTYPE="H" />
            </REGION>
            <REGION REF="1">
                <D VAR="u" VALUE="0" />
                <D VAR="v" VALUE="0" />
                <D VAR="w" VALUE="0" />
                <R VAR="phi" VALUE="0" USERDEFINEDTYPE="ThinConductingWall" PRIMCOEFF="WallLength" />
                <N VAR="p" VALUE="0" USERDEFINEDTYPE="H" />
            </REGION>
            <REGION REF="2">
                <D VAR="u" VALUE="0" />
                <D VAR="v" VALUE="0" />
                <D VAR="w" VALUE="0" />
                <N VAR="phi" VALUE="0" USERDEFINEDTYPE="Insulator" />
                <N VAR="p" VALUE="0" USERDEFINEDTYPE="H" />
            </REGION>
            <REGION REF="3">
                <D VAR="u" VALUE="0" />
                <D VAR="v" VALUE="0" />
                <D VAR="w" VALUE="0" />
                <N VAR="phi" VALUE="0" USERDEFINEDTYPE="Insulator" />
                <N VAR="p" VALUE="0" USERDEFINEDTYPE="H" />
            </REGION>
        </BOUNDARYCONDITIONS>
        <FUNCTION NAME="InitialConditions">
            <E VAR="u" VALUE="0" />
            <E VAR="v" VALUE="0" />
            <E VAR="w" VALUE="0" />
            <E VAR="phi" VALUE="0" />
            <E VAR="p" VALUE="0" />
        </FUNCTION>
        <FUNCTION NAME="ElectricMagneticFields">
            <E VAR="By" VALUE="MagneticFieldStrength" />
        </FUNCTION>
    </CONDITIONS>
    <FORCING>
        <FORCE TYPE="ForcingLorentz">
            <ELECTRICMAGNETICFIELDS>ElectricMagneticFields</ELECTRICMAGNETICFIELDS>
            <IMPLICITDAMPING>True</IMPLICITDAMPING>
        </FORCE>
    </FORCING>
</NEKTAR>