<?xml version="1.0" encoding="utf-8"?>

<NEKTAR xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://www.nektar.info/schema/nektar.xsd">

    <GEOMETRY DIM="2" SPACE="2">
        <VERTEX>
            <V ID="0"> -1.0   -1.0    0.0 </V>
            <V ID="1">  0.0   -1.0    0.0 </V>
            <V ID="2">  1.0   -1.0    0.0 </V>
            <V ID="3">  1.0    0.0    0.0 </V>
            <V ID="4">  1.0    1.0    0.0 </V>
            <V ID="5">  0.0    1.0    0.0 </V>
            <V ID="6"> -1.0    1.0    0.0 </V>
            <V ID="7"> -1.0    0.0    0.0 </V>
            <V ID="8">  0.0    0.0    0.0 </V>
        </VERTEX>

        <EDGE>
            <E ID="0">  0 1  </E>
            <E ID="1">  1 2  </E>
            <E ID="2">  2 3  </E>
            <E ID="3">  3 4  </E>
            <E ID="4">  4 5  </E>
            <E ID="5">  5 6  </E>
            <E ID="6">  6 7  </E>
            <E ID="7">  7 0  </E>
            <E ID="8">  1 8  </E>
            <E ID="9">  8 3  </E>
            <E ID="10">  8 5  </E>
            <E ID="11">  8 7  </E>
        </EDGE>

        <ELEMENT>
            <Q ID="0"> 0 8 11 7 </Q>
            <Q ID="1"> 1 2 9 8 </Q>
            <Q ID="2"> 9 3 4 10 </Q>
            <Q ID="3"> 11 10 5 6 </Q>
        </ELEMENT>

        <COMPOSITE>
            <C ID="0"> Q[0-3] </C>
            <C ID="1"> E[0,1] </C>
            <C ID="2"> E[2,3] </C>
            <C ID="3"> E[4,5] </C>
            <C ID="4"> E[6,7] </C>
        </COMPOSITE>

        <DOMAIN> C[0] </DOMAIN>
    </GEOMETRY>

    <EXPANSIONS>
        <E COMPOSITE="C[0]" NUMMODES="6" TYPE="MODIFIED" FIELDS="u" />
    </EXPANSIONS>

    <CONDITIONS>
        <PARAMETERS>
            <P> epsilon        = 0.2              </P>
            <P> D00            = 0.6              </P>
            <P> D11            = 2                </P>
        </PARAMETERS>

        <SOLVERINFO>
            <I PROPERTY="EQTYPE"                VALUE="PoissonRedesign" />
            <I PROPERTY="Projection"            VALUE="Continuous" />
            <I PROPERTY="GLOBALSYSSOLN"         VALUE="IterativeFull" />
            <I PROPERTY="Preconditioner"        VALUE="Diagonal" />
        </SOLVERINFO>

        <VARIABLES>
            <V ID="0"> u </V>
        </VARIABLES>

        <BOUNDARYREGIONS>
            <B ID="0"> C[1-4] </B>
        </BOUNDARYREGIONS>

        <BOUNDARYCONDITIONS>
            <REGION REF="0">
                <D VAR="u" VALUE="x^3 + y^3" />
            </REGION>
        </BOUNDARYCONDITIONS>

        <FUNCTION NAME="ExactSolution">
            <E VAR="u" VALUE="x^3 + y^3" />
        </FUNCTION>

        <!-- Body force to enforce reaction term -->
        <FUNCTION NAME="BodyForce">
            <E VAR="u" EVARS="u" VALUE="6*x*epsilon*D00 + 6*y*epsilon*D11" />
        </FUNCTION>
    </CONDITIONS>

    <FORCING>
        <FORCE TYPE="Body">
            <BODYFORCE> BodyForce </BODYFORCE>
        </FORCE>
    </FORCING>

</NEKTAR>
