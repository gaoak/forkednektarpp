<?xml version="1.0" encoding="utf-8"?>

<NEKTAR xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://www.nektar.info/schema/nektar.xsd">

    <GEOMETRY DIM="2" SPACE="2">
        <VERTEX>
            <V ID="0"> -1.0   -1.0    0.0 </V>
            <V ID="1">  0.0   -1.0    0.0 </V>
            <V ID="2">  1.0   -1.0    0.0 </V>
            <V ID="3"> -1.0    0.0    0.0 </V>
            <V ID="4">  0.0    0.0    0.0 </V>
            <V ID="5">  1.0    0.0    0.0 </V>
            <V ID="6"> -1.0    1.0    0.0 </V>
            <V ID="7">  0.0    1.0    0.0 </V>
            <V ID="8">  1.0    1.0    0.0 </V>
        </VERTEX>

        <EDGE>
            <E ID="0">  0 1  </E>
            <E ID="1">  1 2  </E>
            <E ID="2">  0 3  </E>
            <E ID="3">  1 4  </E>
            <E ID="4">  2 5  </E>
            <E ID="5">  3 4  </E>
            <E ID="6">  4 5  </E>
            <E ID="7">  6 3  </E>
            <E ID="8">  4 7  </E>
            <E ID="9">  5 8  </E>
            <E ID="10"> 6 7  </E>
            <E ID="11"> 7 8  </E>
            <E ID="12"> 0 4  </E>
            <E ID="13"> 1 5  </E>
        </EDGE>

        <ELEMENT>
            <T ID="0"> 0 3 12 </T>
            <T ID="1"> 2 12 5 </T>
            <T ID="2"> 1 4 13 </T>
            <T ID="3"> 3 13 6 </T>
            <Q ID="4"> 5 8 10 7 </Q>
            <Q ID="5"> 8 6 9 11 </Q>
        </ELEMENT>

        <COMPOSITE>
            <C ID="0"> T[0-3] </C>
            <C ID="1"> Q[4-5] </C>
            <C ID="2"> E[2,7,4,9] </C>
            <C ID="3"> E[0,1,10,11] </C>
        </COMPOSITE>

        <DOMAIN> C[0-1] </DOMAIN>
    </GEOMETRY>

    <EXPANSIONS>
        <E COMPOSITE="C[0]" NUMMODES="10" TYPE="MODIFIED" FIELDS="u" />
        <E COMPOSITE="C[1]" NUMMODES="10" TYPE="MODIFIED" FIELDS="u" />
    </EXPANSIONS>

    <CONDITIONS>
        <PARAMETERS>
            <P> TimeStep       = 0.001                       </P>
            <P> NumSteps       = 100                         </P>
            <P> FinTime        = NumSteps*TimeStep           </P>
            <P> IO_InfoSteps   = NumSteps/20                 </P>
            <P> freq           = PI/2                        </P>
            <P> epsilon        = 0.2                         </P>
            <P> lambda         = 0.1                         </P>
            <P> kappa          = - ( lambda - epsilon * 2.0 * freq * freq ) </P>
        </PARAMETERS>

        <TIMEINTEGRATIONSCHEME>
            <METHOD> IMEX </METHOD>
            <ORDER> 2 </ORDER>
        </TIMEINTEGRATIONSCHEME>

        <SOLVERINFO>
            <I PROPERTY="EQTYPE"                VALUE="UnsteadyDiffusion" />
            <I PROPERTY="Projection"            VALUE="Continuous" />
            <I PROPERTY="DiffusionAdvancement"  VALUE="Implicit" />
            <I PROPERTY="GLOBALSYSSOLN"         VALUE="IterativeFull" />
            <I PROPERTY="LinSysIterSolver"      VALUE="ConjugateGradientLoc" />
            <I PROPERTY="Preconditioner"        VALUE="Diagonal" />
        </SOLVERINFO>

        <VARIABLES>
            <V ID="0"> u </V>
        </VARIABLES>

        <BOUNDARYREGIONS>
            <B ID="0"> C[2-3] </B>
        </BOUNDARYREGIONS>

        <BOUNDARYCONDITIONS>
            <REGION REF="0">
                <D VAR="u" VALUE="0" />
            </REGION>
        </BOUNDARYCONDITIONS>

        <FUNCTION NAME="ExactSolution">
            <E VAR="u" VALUE="exp(-lambda*FinTime)*cos(freq*x)*cos(freq*y)" />
        </FUNCTION>

        <FUNCTION NAME="InitialConditions">
            <E VAR="u" VALUE="cos(freq*x)*cos(freq*y)" />
        </FUNCTION>

        <!-- Body force to enforce reaction term -->
        <FUNCTION NAME="BodyForce">
            <E VAR="u" EVARS="u" VALUE="kappa*u" />
        </FUNCTION>

    </CONDITIONS>

    <FORCING>
        <FORCE TYPE="Body">
            <BODYFORCE> BodyForce </BODYFORCE>
        </FORCE>
    </FORCING>

</NEKTAR>
