<?xml version="1.0" encoding="utf-8" ?>
<NEKTAR>
    <EXPANSIONS>
        <E COMPOSITE="C[7]" NUMMODES="6" TYPE="MODIFIED"
            FIELDS="rho,rhou,rhov,rhow,E" />
    </EXPANSIONS>

    <CONDITIONS>
        <PARAMETERS>
            <P> TimeStep             = 1.0e-8                         </P>
            <P> NumSteps             = 10                             </P>
            <P> IO_InfoSteps         = NumSteps*10                    </P>

            <!-- Stationary shock, as ShockTube_2D_mixedMesh -->
            <P> GasConstant          = 287.058                        </P>
            <P> Gamma                = 1.4                            </P>
            <P> Gp1                  = Gamma + 1.0                    </P>
            <P> Gm1                  = Gamma - 1.0                    </P>
            <P> G2                   = 2.0 * Gamma                    </P>
            <P> x0                   = 0.50                           </P>
            <P> st                   = 0.05                         </P>
            <!-- Left State -->
            <P> Ml                   = 8.0                            </P>
            <P> Tl                   = 298                            </P>
            <P> cl                   = sqrt(Gamma * GasConstant * Tl) </P>
            <P> rhol                 = 1.2                            </P>
            <P> ul                   = cl * Ml                        </P>
            <P> vl                   = 0.0                            </P>
            <P> pl                   = GasConstant * rhol * Tl        </P>
            <P> El = pl / Gm1 + 0.5 * rhol * (ul*ul + vl*vl)          </P>
            <!-- Right State -->
            <P> rhor_rhol            = Gp1 * Ml^2 /( 2.0 + Gm1* Ml^2) </P>
            <P> rhor                 = rhol * rhor_rhol               </P>
            <P> pr_pl                = 1 + G2/Gp1*(Ml^2-1)            </P>
            <P> pr                   = pl * pr_pl                     </P>
            <P> ur                   = ul / rhor_rhol                 </P>
            <P> vr                   = 0.0                            </P>
            <P> Er = pr / Gm1 + 0.5 * rhor * (ur*ur + vr*vr)          </P>
            <P> Pr                   = 0.72                           </P>
            <P> Cp                   = (Gamma / Gm1 )*GasConstant     </P>
            <P> L                    = 1.0                            </P>
            <P> Re                   = 1.0e12                         </P>
            <P> mu = (rhol+rhor)/2 * L * (ul+ur)/2 / Re               </P>
        </PARAMETERS>

        <SOLVERINFO>
            <I PROPERTY="EQType"                VALUE="NavierStokesCFE"     />
            <I PROPERTY="Projection"            VALUE="DisContinuous"       />
            <I PROPERTY="AdvectionType"         VALUE="WeakDG"              />
            <I PROPERTY="DiffusionType"         VALUE="InteriorPenalty"     />
            <I PROPERTY="UpwindType"            VALUE="Roe"                 />
            <I PROPERTY="ProblemType"           VALUE="General"             />
            <I PROPERTY="ShockCaptureType"      VALUE="Physical"            />
            <I PROPERTY="ShockSensorType"       VALUE="Modal"               />
            <I PROPERTY="DucrosSensor"          VALUE="Off"                 />
            <I PROPERTY="Smoothing"             VALUE="Off"                 />
        </SOLVERINFO>

        <TIMEINTEGRATIONSCHEME>
            <METHOD> RungeKutta </METHOD>
            <ORDER> 1 </ORDER>
        </TIMEINTEGRATIONSCHEME>

        <VARIABLES>
            <V ID="0"> rho  </V>
            <V ID="1"> rhou </V>
            <V ID="2"> rhov </V>
            <V ID="3"> rhow </V>
            <V ID="4"> E    </V>
        </VARIABLES>

        <BOUNDARYREGIONS>
            <B ID="0"> C[1] </B>   <!-- inflow,  x = 0 -->
            <B ID="1"> C[2] </B>   <!-- outflow, x = L -->
            <B ID="2"> C[3] </B>   <!-- y = 0,  slip -->
            <B ID="3"> C[4] </B>   <!-- y = Ly, slip -->
            <B ID="4"> C[5] </B>   <!-- z = 0,  slip -->
            <B ID="5"> C[6] </B>   <!-- z = Lz, slip -->
        </BOUNDARYREGIONS>

        <BOUNDARYCONDITIONS>
            <!-- Inflow -->
            <REGION REF="0">
                <D VAR="rho"  VALUE="rhol" />
                <D VAR="rhou" VALUE="rhol * ul" />
                <D VAR="rhov" VALUE="0" />
                <D VAR="rhow" VALUE="0" />
                <D VAR="E"    VALUE="El" />
            </REGION>
            <!-- Outflow -->
            <REGION REF="1">
                <D VAR="rho"  VALUE="rhor" />
                <D VAR="rhou" VALUE="rhor * ur" />
                <D VAR="rhov" VALUE="0" />
                <D VAR="rhow" VALUE="0" />
                <D VAR="E"    VALUE="Er" />
            </REGION>
            <!-- Slip walls in y and z.  The flow is purely axial, so
                u.n vanishes on these faces identically and the condition is
                exact: the solution stays one-dimensional, as it does behind
                the periodic pair of the two-dimensional case. -->
            <REGION REF="2">
                <D VAR="rho"  USERDEFINEDTYPE="Symmetry" VALUE="0" />
                <D VAR="rhou" USERDEFINEDTYPE="Symmetry" VALUE="0" />
                <D VAR="rhov" USERDEFINEDTYPE="Symmetry" VALUE="0" />
                <D VAR="rhow" USERDEFINEDTYPE="Symmetry" VALUE="0" />
                <D VAR="E"    USERDEFINEDTYPE="Symmetry" VALUE="0" />
            </REGION>
            <REGION REF="3">
                <D VAR="rho"  USERDEFINEDTYPE="Symmetry" VALUE="0" />
                <D VAR="rhou" USERDEFINEDTYPE="Symmetry" VALUE="0" />
                <D VAR="rhov" USERDEFINEDTYPE="Symmetry" VALUE="0" />
                <D VAR="rhow" USERDEFINEDTYPE="Symmetry" VALUE="0" />
                <D VAR="E"    USERDEFINEDTYPE="Symmetry" VALUE="0" />
            </REGION>
            <REGION REF="4">
                <D VAR="rho"  USERDEFINEDTYPE="Symmetry" VALUE="0" />
                <D VAR="rhou" USERDEFINEDTYPE="Symmetry" VALUE="0" />
                <D VAR="rhov" USERDEFINEDTYPE="Symmetry" VALUE="0" />
                <D VAR="rhow" USERDEFINEDTYPE="Symmetry" VALUE="0" />
                <D VAR="E"    USERDEFINEDTYPE="Symmetry" VALUE="0" />
            </REGION>
            <REGION REF="5">
                <D VAR="rho"  USERDEFINEDTYPE="Symmetry" VALUE="0" />
                <D VAR="rhou" USERDEFINEDTYPE="Symmetry" VALUE="0" />
                <D VAR="rhov" USERDEFINEDTYPE="Symmetry" VALUE="0" />
                <D VAR="rhow" USERDEFINEDTYPE="Symmetry" VALUE="0" />
                <D VAR="E"    USERDEFINEDTYPE="Symmetry" VALUE="0" />
            </REGION>
        </BOUNDARYCONDITIONS>

        <FUNCTION NAME="InitialConditions">
            <E VAR="rho"  VALUE="rhol + 0.5*(1+tanh((x-x0)/st))*(rhor-rhol)" />
            <E VAR="rhou" VALUE="rhol * ul + 0.5*(1+tanh((x-x0)/st))*(rhor*ur-rhol*ul)" />
            <E VAR="rhov" VALUE="0" />
            <E VAR="rhow" VALUE="0" />
            <E VAR="E"    VALUE="El + 0.5*(1+tanh((x-x0)/st))*(Er-El)" />
        </FUNCTION>

        <FUNCTION NAME="ExactSolution">
            <E VAR="rho"  VALUE="rhol + 0.5*(1+tanh((x-x0)/st))*(rhor-rhol)" />
            <E VAR="rhou" VALUE="rhol * ul + 0.5*(1+tanh((x-x0)/st))*(rhor*ur-rhol*ul)" />
            <E VAR="rhov" VALUE="0" />
            <E VAR="rhow" VALUE="0" />
            <E VAR="E"    VALUE="El + 0.5*(1+tanh((x-x0)/st))*(Er-El)" />
        </FUNCTION>

    </CONDITIONS>
</NEKTAR>
