        <BOUNDARYCONDITIONS>
            <REGION REF="0">
                <R VAR="phi" VALUE="PI*PI*cos(PI*x)*cos(PI*y)*cos(PI*z)" PRIMCOEFF="0.5" USERDEFINEDTYPE="ThinConductingWall" />
            </REGION>
            <REGION REF="1">
                <R VAR="phi" VALUE="PI*PI*cos(PI*x)*cos(PI*y)*cos(PI*z)" PRIMCOEFF="0.5" USERDEFINEDTYPE="ThinConductingWall" />
