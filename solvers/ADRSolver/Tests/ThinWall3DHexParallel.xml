            <REGION REF="5">
                <R VAR="phi" VALUE="-6" PRIMCOEFF="0.5" USERDEFINEDTYPE="ThinConductingWall" />
            </REGION>
        </BOUNDARYCONDITIONS>
        <FUNCTION NAME="InitialConditions">
            <E VAR="phi" VALUE="0" />
