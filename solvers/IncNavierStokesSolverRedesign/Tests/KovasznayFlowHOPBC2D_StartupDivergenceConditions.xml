<?xml version="1.0" encoding="utf-8"?>
<NEKTAR xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://www.nektar.info/schema/nektar.xsd">

    <!--
        Conditions of KovasznayFlowHOPBC2D.xml, integrated for one step of
        the second-order IMEX scheme, taken by its IMEXdirk 2_3_2 start-up,
        from the exact solution with a perturbation of u that vanishes on the
        boundary but is not divergence-free. The pressure of the step is
        dominated by the projection of that perturbation. The start-up
        stages weight the divergence of the solution they start from by the
        multistep coefficient 3/2 instead of their own 1/(1-1/sqrt(2)).
    -->

    <CONDITIONS>
        <SOLVERINFO>
            <I PROPERTY="SolverType" VALUE="VelocityCorrectionScheme" />
            <I PROPERTY="EQTYPE" VALUE="UnsteadyNavierStokes" />
            <I PROPERTY="Projection" VALUE="Galerkin" />
        </SOLVERINFO>

        <TIMEINTEGRATIONSCHEME>
            <METHOD> IMEX </METHOD>
            <ORDER> 2 </ORDER>
        </TIMEINTEGRATIONSCHEME>

        <PARAMETERS>
            <P> TimeStep = 0.01 </P>
            <P> NumSteps = 1 </P>
            <P> IO_InfoSteps = NumSteps </P>
            <P> Kinvis = 0.025 </P>
            <P> IterativeSolverTolerance = 1e-10 </P>
            <P> KovaLam = 0.963740544195769 </P>
            <P> Perturbation = 0.01 </P>
        </PARAMETERS>

        <VARIABLES>
            <V ID="0"> u </V>
            <V ID="1"> v </V>
            <V ID="2"> p </V>
        </VARIABLES>

        <BOUNDARYREGIONS>
            <B ID="0"> C[1] </B>
            <B ID="1"> C[2] </B>
            <B ID="2"> C[3] </B>
        </BOUNDARYREGIONS>

        <BOUNDARYCONDITIONS>
            <!-- Inflow (left, x=-0.5): Dirichlet velocity, Neumann/HOPBC pressure -->
            <REGION REF="0">
                <D VAR="u" VALUE="1-exp(-KovaLam*x)*cos(2*PI*y)" />
                <D VAR="v" VALUE="(-KovaLam/(2*PI))*exp(-KovaLam*x)*sin(2*PI*y)" />
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0" />
            </REGION>
            <!-- Outflow (right, x=1): Dirichlet velocity and pressure -->
            <REGION REF="1">
                <D VAR="u" VALUE="1-exp(-KovaLam*x)*cos(2*PI*y)" />
                <D VAR="v" VALUE="(-KovaLam/(2*PI))*exp(-KovaLam*x)*sin(2*PI*y)" />
                <D VAR="p" VALUE="0.5*(1-exp(-2*KovaLam*x))" />
            </REGION>
            <!-- Top/bottom: Dirichlet velocity, Neumann/HOPBC pressure -->
            <REGION REF="2">
                <D VAR="u" VALUE="1-exp(-KovaLam*x)*cos(2*PI*y)" />
                <D VAR="v" VALUE="(-KovaLam/(2*PI))*exp(-KovaLam*x)*sin(2*PI*y)" />
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0" />
            </REGION>
        </BOUNDARYCONDITIONS>

        <FUNCTION NAME="ExactSolution">
            <E VAR="u" VALUE="1-exp(-KovaLam*x)*cos(2*PI*y)" />
            <E VAR="v" VALUE="(-KovaLam/(2*PI))*exp(-KovaLam*x)*sin(2*PI*y)" />
            <E VAR="p" VALUE="0.5*(1-exp(-2*KovaLam*x))" />
        </FUNCTION>

        <FUNCTION NAME="InitialConditions">
            <E VAR="u" VALUE="1-exp(-KovaLam*x)*cos(2*PI*y)+Perturbation*sin(PI*(x+0.5)/1.5)*sin(PI*(y+0.5)/2)" />
            <E VAR="v" VALUE="(-KovaLam/(2*PI))*exp(-KovaLam*x)*sin(2*PI*y)" />
            <E VAR="p" VALUE="0.5*(1-exp(-2*KovaLam*x))" />
        </FUNCTION>
    </CONDITIONS>
</NEKTAR>
