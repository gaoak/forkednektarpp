<?xml version="1.0" encoding="utf-8"?>
<NEKTAR xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://www.nektar.info/schema/nektar.xsd">
    <CONDITIONS>
        <SOLVERINFO>
            <I PROPERTY="SolverType" VALUE="VelocityCorrectionScheme" />
            <I PROPERTY="EQTYPE" VALUE="UnsteadyNavierStokes" />
            <I PROPERTY="Projection" VALUE="Galerkin" />
            <I PROPERTY="Formulation" VALUE="SemiImplicit" />
        </SOLVERINFO>

        <TIMEINTEGRATIONSCHEME>
            <METHOD> IMEX </METHOD>
            <ORDER> 1 </ORDER>
        </TIMEINTEGRATIONSCHEME>

        <PARAMETERS>
            <P> TimeStep = 0.01 </P>
            <P> NumSteps = 4 </P>
            <P> IO_InfoSteps = NumSteps </P>
            <P> Kinvis = 0.025 </P>
            <P> IterativeSolverTolerance = 1e-14 </P>
            <P> OutflowBC_theta = 0.7 </P>
            <P> OutflowBC_alpha1 = 0.2 </P>
            <P> OutflowBC_alpha2 = 0.1 </P>
            <P> U0_HighOrderBC = 2.0 </P>
            <P> Delta_HighOrderBC = 0.08 </P>
        </PARAMETERS>

        <VARIABLES>
            <V ID="0"> u </V>
            <V ID="1"> v </V>
            <V ID="2"> p </V>
        </VARIABLES>

        <BOUNDARYREGIONS>
            <B ID="0"> C[1] </B>
            <B ID="1"> C[2] </B>
            <B ID="2"> C[3] </B>
        </BOUNDARYREGIONS>

        <BOUNDARYCONDITIONS>
            <REGION REF="0">
                <D VAR="u" VALUE="y" />
                <D VAR="v" VALUE="0" />
                <D VAR="p" VALUE="0" />
            </REGION>
            <REGION REF="1">
                <N VAR="u" USERDEFINEDTYPE="HOutflow" VALUE="0.65*y*y*(0.5*(1-tanh(y/(2.0*0.08))))" />
                <N VAR="v" USERDEFINEDTYPE="HOutflow" VALUE="0" />
                <D VAR="p" USERDEFINEDTYPE="HOutflow" VALUE="0" />
            </REGION>
            <REGION REF="2">
                <D VAR="u" VALUE="y" />
                <D VAR="v" VALUE="0" />
                <D VAR="p" VALUE="0" />
            </REGION>
        </BOUNDARYCONDITIONS>

        <FUNCTION NAME="ExactSolution">
            <E VAR="u" VALUE="y" />
            <E VAR="v" VALUE="0" />
            <E VAR="p" VALUE="0" />
        </FUNCTION>

        <FUNCTION NAME="InitialConditions">
            <E VAR="u" VALUE="y" />
            <E VAR="v" VALUE="0" />
            <E VAR="p" VALUE="0" />
        </FUNCTION>
    </CONDITIONS>
</NEKTAR>
