<?xml version="1.0" encoding="utf-8"?>
<NEKTAR xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://www.nektar.info/schema/nektar.xsd">

    <GEOMETRY DIM="2" SPACE="2">
        <VERTEX>
            <V ID="0"> 0.0 0.0 0.0 </V>
            <V ID="1"> 1.0 0.0 0.0 </V>
            <V ID="2"> 2.0 0.0 0.0 </V>
            <V ID="3"> 3.0 0.0 0.0 </V>
            <V ID="4"> 0.0 1.0 0.0 </V>
            <V ID="5"> 1.0 1.0 0.0 </V>
            <V ID="6"> 2.0 1.0 0.0 </V>
            <V ID="7"> 3.0 1.0 0.0 </V>
            <V ID="8"> 0.0 2.0 0.0 </V>
            <V ID="9"> 1.0 2.0 0.0 </V>
            <V ID="10"> 2.0 2.0 0.0 </V>
            <V ID="11"> 3.0 2.0 0.0 </V>
            <V ID="12"> 0.0 3.0 0.0 </V>
            <V ID="13"> 1.0 3.0 0.0 </V>
            <V ID="14"> 2.0 3.0 0.0 </V>
            <V ID="15"> 3.0 3.0 0.0 </V>
        </VERTEX>

        <EDGE>
            <E ID="0"> 0 1 </E>
            <E ID="1"> 1 2 </E>
            <E ID="2"> 2 3 </E>
            <E ID="3"> 4 5 </E>
            <E ID="4"> 5 6 </E>
            <E ID="5"> 6 7 </E>
            <E ID="6"> 8 9 </E>
            <E ID="7"> 9 10 </E>
            <E ID="8"> 10 11 </E>
            <E ID="9"> 12 13 </E>
            <E ID="10"> 13 14 </E>
            <E ID="11"> 14 15 </E>
            <E ID="12"> 0 4 </E>
            <E ID="13"> 4 8 </E>
            <E ID="14"> 8 12 </E>
            <E ID="15"> 1 5 </E>
            <E ID="16"> 5 9 </E>
            <E ID="17"> 9 13 </E>
            <E ID="18"> 2 6 </E>
            <E ID="19"> 6 10 </E>
            <E ID="20"> 10 14 </E>
            <E ID="21"> 3 7 </E>
            <E ID="22"> 7 11 </E>
            <E ID="23"> 11 15 </E>
            <E ID="24"> 0 5 </E>
        </EDGE>

        <ELEMENT>
            <T ID="0"> 0 15 24 </T>
            <T ID="1"> 24 3 12 </T>
            <Q ID="2"> 1 18 4 15 </Q>
            <Q ID="3"> 2 21 5 18 </Q>
            <Q ID="4"> 3 16 6 13 </Q>
            <Q ID="5"> 4 19 7 16 </Q>
            <Q ID="6"> 5 22 8 19 </Q>
            <Q ID="7"> 6 17 9 14 </Q>
            <Q ID="8"> 7 20 10 17 </Q>
            <Q ID="9"> 8 23 11 20 </Q>
        </ELEMENT>

        <COMPOSITE>
            <C ID="0"> T[0-1] </C>
            <C ID="1"> Q[2-9] </C>
            <C ID="2"> E[0-2] </C>
            <C ID="3"> E[21-23] </C>
            <C ID="4"> E[9-11] </C>
            <C ID="5"> E[12-14] </C>
        </COMPOSITE>

        <DOMAIN> C[0-1] </DOMAIN>
    </GEOMETRY>

    <EXPANSIONS>
        <E COMPOSITE="C[0]" NUMMODES="4" FIELDS="u,v,p" TYPE="MODIFIED" />
        <E COMPOSITE="C[1]" NUMMODES="4" FIELDS="u,v,p" TYPE="MODIFIED" />
    </EXPANSIONS>

    <CONDITIONS>
        <SOLVERINFO>
            <I PROPERTY="SolverType" VALUE="VelocityCorrectionScheme" />
            <I PROPERTY="EQTYPE" VALUE="UnsteadyNavierStokes" />
            <I PROPERTY="AdvectionForm" VALUE="Convective" />
            <I PROPERTY="Projection" VALUE="Galerkin" />
        </SOLVERINFO>

        <TIMEINTEGRATIONSCHEME>
            <METHOD> IMEX </METHOD>
            <ORDER> 1 </ORDER>
        </TIMEINTEGRATIONSCHEME>

        <PARAMETERS>
            <P> TimeStep = 0.01 </P>
            <P> NumSteps = 1 </P>
            <P> IO_InfoSteps = 1 </P>
            <P> Kinvis = 1 </P>
            <P> IterativeSolverTolerance = 1e-14 </P>
        </PARAMETERS>

        <VARIABLES>
            <V ID="0"> u </V>
            <V ID="1"> v </V>
            <V ID="2"> p </V>
        </VARIABLES>

        <BOUNDARYREGIONS>
            <B ID="0"> C[2] </B>
            <B ID="1"> C[3-5] </B>
        </BOUNDARYREGIONS>

        <BOUNDARYCONDITIONS>
            <REGION REF="0">
                <D VAR="u" VALUE="y*(3-y)" />
                <D VAR="v" VALUE="0" />
                <D VAR="p" VALUE="-2*Kinvis*x" />
            </REGION>
            <REGION REF="1">
                <D VAR="u" VALUE="y*(3-y)" />
                <D VAR="v" VALUE="0" />
                <D VAR="p" VALUE="-2*Kinvis*x" />
            </REGION>
        </BOUNDARYCONDITIONS>

        <FUNCTION NAME="InitialConditions">
            <E VAR="u" VALUE="y*(3-y)" />
            <E VAR="v" VALUE="0" />
            <E VAR="p" VALUE="-2*Kinvis*x" />
        </FUNCTION>

        <FUNCTION NAME="ExactSolution">
            <E VAR="u" VALUE="y*(3-y)" />
            <E VAR="v" VALUE="0" />
            <E VAR="p" VALUE="-2*Kinvis*x" />
        </FUNCTION>
    </CONDITIONS>
</NEKTAR>
