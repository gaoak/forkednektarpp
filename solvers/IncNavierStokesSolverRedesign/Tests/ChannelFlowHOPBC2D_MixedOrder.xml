<?xml version="1.0" encoding="utf-8"?>
<NEKTAR>
    <!--
        Expansions of ChannelFlowHOPBC2D.xml with a pressure one order below
        the velocity: P=2 velocity (MODIFIED, NUMMODES=3) and P=1 pressure
        (MODIFIEDQUADPLUS1, NUMMODES=2), which share their quadrature points
        on the triangles and the quadrilaterals. The quadratic inflow profile
        on the high-order pressure boundary is exact in the velocity boundary
        space but not in the pressure boundary space.
    -->
    <EXPANSIONS>
        <E COMPOSITE="C[0-1]" NUMMODES="3" FIELDS="u,v" TYPE="MODIFIED" />
        <E COMPOSITE="C[0-1]" NUMMODES="2" FIELDS="p" TYPE="MODIFIEDQUADPLUS1" />
    </EXPANSIONS>
</NEKTAR>
