<?xml version="1.0" encoding="utf-8"?>
<NEKTAR xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://www.nektar.info/schema/nektar.xsd">
    <!--
        Manufactured solution, with a non-zero curl-curl of the velocity,

        u = exp(t)*y*(1-y),  v = 0,  p = exp(2*t)*(x-0.5)*(y-0.5),

        driven by the body force f = du/dt - Kinvis*laplacian(u) + grad(p).

        Three pressure edges use the higher-order pressure boundary condition and the
        right edge supplies a time-dependent pressure reference. The Python
        convergence test check_hopbc_time_order.py sets these functions, the
        time-dependent velocity boundary values, the time step and the
        integration order.
    -->
    <GEOMETRY DIM="2" SPACE="2">
        <VERTEX>
            <V ID="0"> 0 0 0 </V>
            <V ID="1"> 0.5 0 0 </V>
            <V ID="2"> 1 0 0 </V>
            <V ID="3"> 0 1 0 </V>
            <V ID="4"> 0.5 1 0 </V>
            <V ID="5"> 1 1 0 </V>
        </VERTEX>
        <EDGE>
            <E ID="0"> 0 1 </E>
            <E ID="1"> 1 2 </E>
            <E ID="2"> 2 5 </E>
            <E ID="3"> 5 4 </E>
            <E ID="4"> 4 3 </E>
            <E ID="5"> 3 0 </E>
            <E ID="6"> 1 4 </E>
        </EDGE>
        <ELEMENT>
            <Q ID="0"> 0 6 4 5 </Q>
            <Q ID="1"> 1 2 3 6 </Q>
        </ELEMENT>
        <COMPOSITE>
            <C ID="0"> Q[0-1] </C>
            <C ID="1"> E[0-1] </C>
            <C ID="2"> E[2] </C>
            <C ID="3"> E[3-4] </C>
            <C ID="4"> E[5] </C>
        </COMPOSITE>
        <DOMAIN> C[0] </DOMAIN>
    </GEOMETRY>

    <EXPANSIONS>
        <E COMPOSITE="C[0]" NUMMODES="8" FIELDS="u,v,p"
            TYPE="MODIFIED" />
    </EXPANSIONS>

    <CONDITIONS>
        <SOLVERINFO>
            <I PROPERTY="SolverType" VALUE="VelocityCorrectionScheme" />
            <I PROPERTY="EQTYPE" VALUE="UnsteadyNavierStokes" />
            <I PROPERTY="Projection" VALUE="Galerkin" />
        </SOLVERINFO>

        <TIMEINTEGRATIONSCHEME>
            <METHOD> IMEX </METHOD>
            <ORDER> 2 </ORDER>
        </TIMEINTEGRATIONSCHEME>

        <PARAMETERS>
            <P> TimeStep = 0.025 </P>
            <P> NumSteps = 4 </P>
            <P> IO_InfoSteps = 4 </P>
            <P> Kinvis = 0.05 </P>
            <P> IterativeSolverTolerance = 1e-12 </P>
            <P> NekLinSysMaxIterations = 1000 </P>
        </PARAMETERS>

        <VARIABLES>
            <V ID="0"> u </V>
            <V ID="1"> v </V>
            <V ID="2"> p </V>
        </VARIABLES>

        <BOUNDARYREGIONS>
            <B ID="0"> C[1,3-4] </B>
            <B ID="1"> C[2] </B>
        </BOUNDARYREGIONS>

        <BOUNDARYCONDITIONS>
            <REGION REF="0">
                <D VAR="u" VALUE="0" />
                <D VAR="v" VALUE="0" />
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0" />
            </REGION>
            <REGION REF="1">
                <D VAR="u" VALUE="0" />
                <D VAR="v" VALUE="0" />
                <D VAR="p" USERDEFINEDTYPE="TimeDependent" VALUE="0" />
            </REGION>
        </BOUNDARYCONDITIONS>

        <FUNCTION NAME="InitialConditions">
            <E VAR="u" VALUE="0" />
            <E VAR="v" VALUE="0" />
            <E VAR="p" VALUE="0" />
        </FUNCTION>

        <FUNCTION NAME="ExactSolution">
            <E VAR="u" VALUE="0" />
            <E VAR="v" VALUE="0" />
            <E VAR="p" VALUE="0" />
        </FUNCTION>

        <FUNCTION NAME="BodyForce">
            <E VAR="u" VALUE="0" />
            <E VAR="v" VALUE="0" />
        </FUNCTION>
    </CONDITIONS>

    <FORCING>
        <FORCE TYPE="Body">
            <BODYFORCE> BodyForce </BODYFORCE>
        </FORCE>
    </FORCING>
</NEKTAR>
