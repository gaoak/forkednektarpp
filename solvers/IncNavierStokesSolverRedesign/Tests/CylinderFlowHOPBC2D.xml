<?xml version="1.0" encoding="utf-8"?>
<NEKTAR xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://www.nektar.info/schema/nektar.xsd">

    <!--
        Steady manufactured incompressible Navier--Stokes solution on a
        two-ring, faceted-cylinder O-grid. With A = Amp,

        u =  2 A x^2 y,
        v = -2 A x y^2,
        p = x + y,

        so div(u) = 0, advection and CurlCurl(u) are both non-zero, and the body
        force is

        f = u.grad(u) + grad(p) - Kinvis*Laplacian(u).

        Consequently the explicit pressure-boundary RHS satisfies

        -u.grad(u) + f - Kinvis*CurlCurl(u) = grad(p),

        which gives the exact pressure normal derivative on each HOPBC region.
        Pressure is Dirichlet on the downstream outer wedge to fix its constant.
        Velocity is prescribed from the exact solution on the whole boundary.

        This is a numerical HOPBC test on cylinder-like geometry, rather than a
        physical no-slip cylinder-flow benchmark. Initialising at the steady
        exact solution keeps the test to one time step and makes the reported L2
        and Linf values genuine discretisation errors.
    -->

    <GEOMETRY DIM="2" SPACE="2">
        <VERTEX>
            <V ID="0"> 0.5 0 0.0 </V>
            <V ID="1"> 0.353553390593 0.353553390593 0.0 </V>
            <V ID="2"> 3.06161699787e-17 0.5 0.0 </V>
            <V ID="3"> -0.353553390593 0.353553390593 0.0 </V>
            <V ID="4"> -0.5 6.12323399574e-17 0.0 </V>
            <V ID="5"> -0.353553390593 -0.353553390593 0.0 </V>
            <V ID="6"> -9.18485099361e-17 -0.5 0.0 </V>
            <V ID="7"> 0.353553390593 -0.353553390593 0.0 </V>
            <V ID="8"> 1.58113883008 0 0.0 </V>
            <V ID="9"> 1.11803398875 1.11803398875 0.0 </V>
            <V ID="10"> 9.68168303635e-17 1.58113883008 0.0 </V>
            <V ID="11"> -1.11803398875 1.11803398875 0.0 </V>
            <V ID="12"> -1.58113883008 1.93633660727e-16 0.0 </V>
            <V ID="13"> -1.11803398875 -1.11803398875 0.0 </V>
            <V ID="14"> -2.90450491091e-16 -1.58113883008 0.0 </V>
            <V ID="15"> 1.11803398875 -1.11803398875 0.0 </V>
            <V ID="16"> 5 0 0.0 </V>
            <V ID="17"> 3.53553390593 3.53553390593 0.0 </V>
            <V ID="18"> 3.06161699787e-16 5 0.0 </V>
            <V ID="19"> -3.53553390593 3.53553390593 0.0 </V>
            <V ID="20"> -5 6.12323399574e-16 0.0 </V>
            <V ID="21"> -3.53553390593 -3.53553390593 0.0 </V>
            <V ID="22"> -9.18485099361e-16 -5 0.0 </V>
            <V ID="23"> 3.53553390593 -3.53553390593 0.0 </V>
        </VERTEX>

        <EDGE>
            <E ID="0"> 0 1 </E>
            <E ID="1"> 1 2 </E>
            <E ID="2"> 2 3 </E>
            <E ID="3"> 3 4 </E>
            <E ID="4"> 4 5 </E>
            <E ID="5"> 5 6 </E>
            <E ID="6"> 6 7 </E>
            <E ID="7"> 7 0 </E>
            <E ID="8"> 8 9 </E>
            <E ID="9"> 9 10 </E>
            <E ID="10"> 10 11 </E>
            <E ID="11"> 11 12 </E>
            <E ID="12"> 12 13 </E>
            <E ID="13"> 13 14 </E>
            <E ID="14"> 14 15 </E>
            <E ID="15"> 15 8 </E>
            <E ID="16"> 16 17 </E>
            <E ID="17"> 17 18 </E>
            <E ID="18"> 18 19 </E>
            <E ID="19"> 19 20 </E>
            <E ID="20"> 20 21 </E>
            <E ID="21"> 21 22 </E>
            <E ID="22"> 22 23 </E>
            <E ID="23"> 23 16 </E>
            <E ID="24"> 0 8 </E>
            <E ID="25"> 1 9 </E>
            <E ID="26"> 2 10 </E>
            <E ID="27"> 3 11 </E>
            <E ID="28"> 4 12 </E>
            <E ID="29"> 5 13 </E>
            <E ID="30"> 6 14 </E>
            <E ID="31"> 7 15 </E>
            <E ID="32"> 8 16 </E>
            <E ID="33"> 9 17 </E>
            <E ID="34"> 10 18 </E>
            <E ID="35"> 11 19 </E>
            <E ID="36"> 12 20 </E>
            <E ID="37"> 13 21 </E>
            <E ID="38"> 14 22 </E>
            <E ID="39"> 15 23 </E>
            <E ID="40"> 0 9 </E>
        </EDGE>

        <ELEMENT>
            <Q ID="1"> 25 9 26 1 </Q>
            <Q ID="2"> 26 10 27 2 </Q>
            <Q ID="3"> 27 11 28 3 </Q>
            <Q ID="4"> 28 12 29 4 </Q>
            <Q ID="5"> 29 13 30 5 </Q>
            <Q ID="6"> 30 14 31 6 </Q>
            <Q ID="7"> 31 15 24 7 </Q>
            <Q ID="8"> 32 16 33 8 </Q>
            <Q ID="9"> 33 17 34 9 </Q>
            <Q ID="10"> 34 18 35 10 </Q>
            <Q ID="11"> 35 19 36 11 </Q>
            <Q ID="12"> 36 20 37 12 </Q>
            <Q ID="13"> 37 21 38 13 </Q>
            <Q ID="14"> 38 22 39 14 </Q>
            <Q ID="15"> 39 23 32 15 </Q>
            <T ID="0"> 24 8 40 </T>
            <T ID="16"> 40 25 0 </T>
        </ELEMENT>

        <COMPOSITE>
            <C ID="0"> Q[1-15] T[0,16] </C>
            <C ID="1"> E[0-7] </C>
            <C ID="2"> E[17-22] </C>
            <C ID="3"> E[16,23] </C>
        </COMPOSITE>

        <DOMAIN> C[0] </DOMAIN>
    </GEOMETRY>

    <EXPANSIONS>
        <E COMPOSITE="C[0]" NUMMODES="6" FIELDS="u,v,p" TYPE="MODIFIED" />
    </EXPANSIONS>

    <CONDITIONS>
        <SOLVERINFO>
            <I PROPERTY="SolverType" VALUE="VelocityCorrectionScheme" />
            <I PROPERTY="EQTYPE" VALUE="UnsteadyNavierStokes" />
            <I PROPERTY="Projection" VALUE="Galerkin" />
        </SOLVERINFO>

        <TIMEINTEGRATIONSCHEME>
            <METHOD> IMEX </METHOD>
            <ORDER> 1 </ORDER>
        </TIMEINTEGRATIONSCHEME>

        <PARAMETERS>
            <P> TimeStep = 0.01 </P>
            <P> NumSteps = 1 </P>
            <P> IO_InfoSteps = 1 </P>
            <P> Kinvis = 0.05 </P>
            <P> Amp = 0.01 </P>
            <P> IterativeSolverTolerance = 1e-10 </P>
        </PARAMETERS>

        <VARIABLES>
            <V ID="0"> u </V>
            <V ID="1"> v </V>
            <V ID="2"> p </V>
        </VARIABLES>

        <BOUNDARYREGIONS>
            <B ID="0"> C[1] </B>
            <B ID="1"> C[2] </B>
            <B ID="2"> C[3] </B>
        </BOUNDARYREGIONS>

        <BOUNDARYCONDITIONS>
            <!-- Cylinder wall: exact velocity, high-order pressure BC -->
            <REGION REF="0">
                <D VAR="u" VALUE="2*Amp*x*x*y" />
                <D VAR="v" VALUE="-2*Amp*x*y*y" />
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0" />
            </REGION>
            <!-- Outer HOPBC region: exact velocity, high-order pressure BC -->
            <REGION REF="1">
                <D VAR="u" VALUE="2*Amp*x*x*y" />
                <D VAR="v" VALUE="-2*Amp*x*y*y" />
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0" />
            </REGION>
            <!-- Downstream wedge: exact velocity and pressure -->
            <REGION REF="2">
                <D VAR="u" VALUE="2*Amp*x*x*y" />
                <D VAR="v" VALUE="-2*Amp*x*y*y" />
                <D VAR="p" VALUE="x+y" />
            </REGION>
        </BOUNDARYCONDITIONS>

        <FUNCTION NAME="InitialConditions">
            <E VAR="u" VALUE="2*Amp*x*x*y" />
            <E VAR="v" VALUE="-2*Amp*x*y*y" />
            <E VAR="p" VALUE="x+y" />
        </FUNCTION>

        <FUNCTION NAME="ExactSolution">
            <E VAR="u" VALUE="2*Amp*x*x*y" />
            <E VAR="v" VALUE="-2*Amp*x*y*y" />
            <E VAR="p" VALUE="x+y" />
        </FUNCTION>

        <FUNCTION NAME="BodyForce">
            <E VAR="u" VALUE="4*Amp*Amp*x*x*x*y*y+1-4*Kinvis*Amp*y" />
            <E VAR="v" VALUE="4*Amp*Amp*x*x*y*y*y+1+4*Kinvis*Amp*x" />
        </FUNCTION>
    </CONDITIONS>

    <FORCING>
        <FORCE TYPE="Body">
            <BODYFORCE> BodyForce </BODYFORCE>
        </FORCE>
    </FORCING>
</NEKTAR>
