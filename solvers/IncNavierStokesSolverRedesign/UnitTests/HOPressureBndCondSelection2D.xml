<?xml version="1.0" encoding="utf-8"?>
<NEKTAR>
    <GEOMETRY DIM="2" SPACE="2">
        <VERTEX>
            <V ID="0"> -1.0 -1.0 0.0 </V>
            <V ID="1">  0.0 -1.0 0.0 </V>
            <V ID="2">  1.0 -1.0 0.0 </V>
            <V ID="3"> -1.0  1.0 0.0 </V>
            <V ID="4">  0.0  1.0 0.0 </V>
            <V ID="5">  1.0  1.0 0.0 </V>
        </VERTEX>
        <EDGE>
            <E ID="0"> 0 1 </E>
            <E ID="1"> 1 4 </E>
            <E ID="2"> 4 3 </E>
            <E ID="3"> 3 0 </E>
            <E ID="4"> 1 2 </E>
            <E ID="5"> 2 5 </E>
            <E ID="6"> 5 4 </E>
        </EDGE>
        <ELEMENT>
            <Q ID="0"> 0 1 2 3 </Q>
            <Q ID="1"> 4 5 6 1 </Q>
        </ELEMENT>
        <COMPOSITE>
            <C ID="0"> Q[0-1] </C>
            <C ID="1"> E[0,4] </C>
            <C ID="2"> E[5] </C>
            <C ID="3"> E[2,6] </C>
            <C ID="4"> E[3] </C>
        </COMPOSITE>
        <DOMAIN> C[0] </DOMAIN>
    </GEOMETRY>

    <EXPANSIONS>
        <E COMPOSITE="C[0]" NUMMODES="5" TYPE="MODIFIED"
            FIELDS="u,v,p" />
    </EXPANSIONS>

    <CONDITIONS>
        <SOLVERINFO>
            <I PROPERTY="GLOBALSYSSOLN" VALUE="IterativeFull" />
            <I PROPERTY="PROJECTION" VALUE="Continuous" />
        </SOLVERINFO>

        <PARAMETERS>
            <!-- Marks this session for
                update_then_apply_selection_respects_hop_tag, so that test
                case can identify its own fixture and skip on every other
                HOPressureBndCond unit-test session. -->
            <P> HOPSelectionTest = 1 </P>
        </PARAMETERS>

        <VARIABLES>
            <V ID="0"> u </V>
            <V ID="1"> v </V>
            <V ID="2"> p </V>
        </VARIABLES>

        <BOUNDARYREGIONS>
            <B ID="0"> C[1] </B>
            <B ID="1"> C[2] </B>
            <B ID="2"> C[3] </B>
            <B ID="3"> C[4] </B>
        </BOUNDARYREGIONS>

        <BOUNDARYCONDITIONS>
            <!-- Higher-order pressure region: Dirichlet velocity and a
                Neumann pressure with USERDEFINEDTYPE="H". -->
            <REGION REF="0">
                <D VAR="u" USERDEFINEDTYPE="TimeDependent" VALUE="t" />
                <D VAR="v" USERDEFINEDTYPE="TimeDependent" VALUE="2*t" />
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="2*x-2*x*x" />
            </REGION>
            <!-- Neumann pressure region without USERDEFINEDTYPE="H", with a
                Neumann velocity: HOPressureBndCond does not select it,
                contributes nothing on it and does not require a Dirichlet
                velocity. -->
            <REGION REF="1">
                <N VAR="u" VALUE="0" />
                <N VAR="v" VALUE="0" />
                <N VAR="p" VALUE="0.5" />
            </REGION>
            <!-- A second higher-order pressure region. -->
            <REGION REF="2">
                <D VAR="u" USERDEFINEDTYPE="TimeDependent" VALUE="t" />
                <D VAR="v" USERDEFINEDTYPE="TimeDependent" VALUE="2*t" />
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="2*x+2*x*x" />
            </REGION>
            <!-- Unrelated Dirichlet-pressure region, closing the domain. -->
            <REGION REF="3">
                <D VAR="u" USERDEFINEDTYPE="TimeDependent" VALUE="t" />
                <D VAR="v" USERDEFINEDTYPE="TimeDependent" VALUE="2*t" />
                <D VAR="p" VALUE="1+y*y+2*y" />
            </REGION>
        </BOUNDARYCONDITIONS>
    </CONDITIONS>
</NEKTAR>
