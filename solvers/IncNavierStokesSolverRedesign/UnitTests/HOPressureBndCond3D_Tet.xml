<?xml version="1.0" encoding="utf-8"?>
<NEKTAR>
    <GEOMETRY DIM="3" SPACE="3">
        <VERTEX>
            <V ID="0"> 0.0 0.0 0.0 </V>
            <V ID="1"> 1.0 0.0 0.0 </V>
            <V ID="2"> 0.0 1.0 0.0 </V>
            <V ID="3"> 0.0 0.0 1.0 </V>
        </VERTEX>
        <EDGE>
            <E ID="0"> 0 1 </E>
            <E ID="1"> 0 2 </E>
            <E ID="2"> 0 3 </E>
            <E ID="3"> 1 2 </E>
            <E ID="4"> 1 3 </E>
            <E ID="5"> 2 3 </E>
        </EDGE>
        <FACE>
            <T ID="0"> 0 3 1 </T>
            <T ID="1"> 0 4 2 </T>
            <T ID="2"> 3 5 4 </T>
            <T ID="3"> 1 5 2 </T>
        </FACE>
        <ELEMENT>
            <A ID="0"> 0 1 2 3 </A>
        </ELEMENT>
        <COMPOSITE>
            <C ID="0"> A[0] </C>
            <C ID="1"> F[0-2] </C>
            <C ID="2"> F[3] </C>
        </COMPOSITE>
        <DOMAIN> C[0] </DOMAIN>
    </GEOMETRY>

    <EXPANSIONS>
        <E COMPOSITE="C[0]" NUMMODES="5" TYPE="MODIFIED"
            FIELDS="u,v,w,p" />
    </EXPANSIONS>

    <CONDITIONS>
        <SOLVERINFO>
            <I PROPERTY="GLOBALSYSSOLN" VALUE="IterativeFull" />
            <I PROPERTY="PROJECTION" VALUE="Continuous" />
        </SOLVERINFO>
        <VARIABLES>
            <V ID="0"> u </V>
            <V ID="1"> v </V>
            <V ID="2"> w </V>
            <V ID="3"> p </V>
        </VARIABLES>
        <BOUNDARYREGIONS>
            <B ID="0"> C[1] </B>
            <B ID="1"> C[2] </B>
        </BOUNDARYREGIONS>
        <BOUNDARYCONDITIONS>
            <REGION REF="0">
                <D VAR="u" USERDEFINEDTYPE="TimeDependent" VALUE="t" />
                <D VAR="v" USERDEFINEDTYPE="TimeDependent" VALUE="2*t" />
                <D VAR="w" USERDEFINEDTYPE="TimeDependent" VALUE="3*t" />
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0" />
            </REGION>
            <REGION REF="1">
                <D VAR="u" USERDEFINEDTYPE="TimeDependent" VALUE="t" />
                <D VAR="v" USERDEFINEDTYPE="TimeDependent" VALUE="2*t" />
                <D VAR="w" USERDEFINEDTYPE="TimeDependent" VALUE="3*t" />
                <D VAR="p" VALUE="0" />
            </REGION>
        </BOUNDARYCONDITIONS>
    </CONDITIONS>
</NEKTAR>
