<?xml version="1.0" encoding="utf-8" ?>
<NEKTAR>
    <GEOMETRY DIM="1" SPACE="1">
        <VERTEX>
            <V ID="0"> -1.0  0.0  0.0</V>
            <V ID="1"> -0.8  0.0  0.0</V>
            <V ID="2"> -0.6  0.0  0.0</V>
            <V ID="3"> -0.4  0.0  0.0</V>
            <V ID="4"> -0.2  0.0  0.0</V>
            <V ID="5">  0.0  0.0  0.0</V>
            <V ID="6">  0.2  0.0  0.0</V>
            <V ID="7">  0.4  0.0  0.0</V>
            <V ID="8">  0.6  0.0  0.0</V>
            <V ID="9">  0.8  0.0  0.0</V>
            <V ID="10"> 1.0  0.0  0.0</V>
        </VERTEX>
        <ELEMENT>
            <S ID="0">    0     1 </S>
            <S ID="1">    1     2 </S>
            <S ID="2">    2     3 </S>
            <S ID="3">    3     4 </S>
            <S ID="4">    4     5 </S>
            <S ID="5">    5     6 </S>
            <S ID="6">    6     7 </S>
            <S ID="7">    7     8 </S>
            <S ID="8">    8     9 </S>
            <S ID="9">    9    10 </S>
        </ELEMENT>
        <COMPOSITE>
            <C ID="0"> S[0-9] </C>
            <C ID="1"> V[0]   </C>
            <C ID="2"> V[10]  </C>
        </COMPOSITE>
        <DOMAIN> C[0] </DOMAIN>
    </GEOMETRY>
    <EXPANSIONS>
        <E COMPOSITE="C[0]" FIELDS="p,u" TYPE="MODIFIED" NUMMODES="6"/>
    </EXPANSIONS>
    <CONDITIONS>
        <PARAMETERS>
            <P> TimeStep      = 1e-07                   </P>
            <P> NumSteps      = 300                     </P>
            <P> FinTime       = TimeStep*NumSteps       </P>
            <P> IO_InfoSteps  = 10                      </P>

            <P> LinerType     = 0                       </P>
            <P> w0             = 1.129341573967544e+03  </P>
            <P> wI          = 2.552709408621595         </P>
            <P> u0 = 1.083268522636659                  </P>
            <P> uI = -0.519856677269848                 </P>

            <P> r0 = 1.23                               </P>
            <P> c0 = 340                                </P>
            <P> M0 = 0.0294                             </P>
        </PARAMETERS>

        <TIMEINTEGRATIONSCHEME>
            <METHOD> RungeKutta </METHOD>
            <ORDER> 4 </ORDER>
        </TIMEINTEGRATIONSCHEME>

        <SOLVERINFO>
            <I PROPERTY="EQTYPE"                VALUE="APE"           />
            <I PROPERTY="Projection"            VALUE="DisContinuous" />
            <I PROPERTY="UpwindType"            VALUE="LaxFriedrichs" />
        </SOLVERINFO>

        <VARIABLES>
            <V ID="0"> p    </V>
            <V ID="1"> u </V>
        </VARIABLES>

        <BOUNDARYREGIONS>
            <B ID="1"> C[1] </B>
            <B ID="2"> C[2] </B>
        </BOUNDARYREGIONS>

        <BOUNDARYCONDITIONS>
            <REGION REF="1">
                <D VAR="p" USERDEFINEDTYPE="Wall" VALUE="0" />
                <D VAR="u" USERDEFINEDTYPE="Wall" VALUE="0" />
            </REGION>
            <REGION REF="2">
                <D VAR="p" USERDEFINEDTYPE="LinerBC" VALUE="0" />
                <D VAR="u" USERDEFINEDTYPE="LinerBC" VALUE="0" />
            </REGION>
        </BOUNDARYCONDITIONS>

        <FUNCTION NAME="Baseflow">
            <E VAR="c0sq" VALUE="c0*c0" />
            <E VAR="rho0" VALUE="r0" />
            <E VAR="u0" VALUE="c0*M0" />
        </FUNCTION>

        <FUNCTION NAME="InitialConditions">
            <E VAR="p" VALUE="r0*c0*(exp(wI/c0/(1+M0)*(x))*cos(-w0/c0/(1+M0)*(x))+exp(-wI/c0/(1-M0)*(x))*cos(w0/c0/(1-M0)*(x)))" />
            <E VAR="u" VALUE="exp(wI/c0/(1+M0)*(x))*cos(-w0/c0/(1+M0)*(x))-exp(-wI/c0/(1-M0)*(x))*cos(w0/c0/(1-M0)*(x))" />
        </FUNCTION>

        <FUNCTION NAME="RationalFraction">
            <E VAR="A0" VALUE="8.333432886643921*1e6" />
            <E VAR="A1" VALUE="0.199971852470347*1e6" />
            <E VAR="A2" VALUE="0.001123670329966*1e6" />
            <E VAR="A3" VALUE="1.0" />
            <E VAR="B0" VALUE="-7.228420908799834*1e6" />
            <E VAR="B1" VALUE="-0.159965320270149*1e6" />
            <E VAR="B2" VALUE="-0.000607940813080*1e6" />
            <E VAR="B3" VALUE="0.000001000001475*1e6" />
        </FUNCTION>

        <FORCING>
            <FORCE TYPE="Field">
                <FIELDFORCE> Source <FIELDFORCE/>
            </FORCE>
        </FORCING>

    </CONDITIONS>
</NEKTAR>
