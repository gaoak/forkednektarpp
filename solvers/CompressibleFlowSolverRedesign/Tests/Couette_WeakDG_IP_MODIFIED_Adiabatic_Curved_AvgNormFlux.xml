        <CURVED>
            <E ID="0" EDGEID="0" NUMPOINTS="3" TYPE="PolyEvenlySpaced">-1.00000000e+00 5.00000000e-01 0.00000000e+00   -1.00000000e+00 7.50000000e-01 0.00000000e+00   -1.00000000e+00 1.00000000e+00 0.00000000e+00</E>
            <E ID="1" EDGEID="1" NUMPOINTS="3" TYPE="PolyEvenlySpaced">-2.75024448e-12 5.00000000e-01 0.00000000e+00   -5.00000000e-01 5.00000000e-01 0.00000000e+00   -1.00000000e+00 5.00000000e-01 0.00000000e+00</E>
            <E ID="2" EDGEID="2" NUMPOINTS="3" TYPE="PolyEvenlySpaced">-2.75024448e-12 1.00000000e+00 0.00000000e+00   -2.75024448e-12 7.50000000e-01 0.00000000e+00   -2.75024448e-12 5.00000000e-01 0.00000000e+00</E>
            <E ID="3" EDGEID="3" NUMPOINTS="3" TYPE="PolyEvenlySpaced">-1.00000000e+00 1.00000000e+00 0.00000000e+00   -5.00000000e-01 1.00000000e+00 0.00000000e+00   -2.75024448e-12 1.00000000e+00 0.00000000e+00</E>
            <E ID="4" EDGEID="4" NUMPOINTS="3" TYPE="PolyEvenlySpaced">-1.00000000e+00 0.00000000e+00 0.00000000e+00   -1.00000000e+00 2.50000000e-01 0.00000000e+00   -1.00000000e+00 5.00000000e-01 0.00000000e+00</E>
            <E ID="5" EDGEID="5" NUMPOINTS="3" TYPE="PolyEvenlySpaced">-2.75024448e-12 0.00000000e+00 0.00000000e+00   -5.00000000e-01 0.00000000e+00 0.00000000e+00   -1.00000000e+00 0.00000000e+00 0.00000000e+00</E>
            <E ID="6" EDGEID="6" NUMPOINTS="3" TYPE="PolyEvenlySpaced">-2.75024448e-12 5.00000000e-01 0.00000000e+00   -2.75024448e-12 2.50000000e-01 0.00000000e+00   -2.75024448e-12 0.00000000e+00 0.00000000e+00</E>
            <E ID="7" EDGEID="7" NUMPOINTS="3" TYPE="PolyEvenlySpaced">1.00000000e+00 5.00000000e-01 0.00000000e+00   5.00000000e-01 5.00000000e-01 0.00000000e+00   -2.75024448e-12 5.00000000e-01 0.00000000e+00</E>
            <E ID="8" EDGEID="8" NUMPOINTS="3" TYPE="PolyEvenlySpaced">1.00000000e+00 1.00000000e+00 0.00000000e+00   1.00000000e+00 7.50000000e-01 0.00000000e+00   1.00000000e+00 5.00000000e-01 0.00000000e+00</E>
            <E ID="9" EDGEID="9" NUMPOINTS="3" TYPE="PolyEvenlySpaced">-2.75024448e-12 1.00000000e+00 0.00000000e+00   5.00000000e-01 1.00000000e+00 0.00000000e+00   1.00000000e+00 1.00000000e+00 0.00000000e+00</E>
