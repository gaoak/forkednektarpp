            <E ID="11" EDGEID="11" NUMPOINTS="3" TYPE="PolyEvenlySpaced">1.00000000e+00 5.00000000e-01 0.00000000e+00   1.00000000e+00 2.50000000e-01 0.00000000e+00   1.00000000e+00 0.00000000e+00 0.00000000e+00</E>
