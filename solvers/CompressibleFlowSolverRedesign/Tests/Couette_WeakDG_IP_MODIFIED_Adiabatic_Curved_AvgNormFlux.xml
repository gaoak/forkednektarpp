    <Metadata>
        <Provenance>
            <GitBranch>refs/heads/feature_ImplicitSolver_UWI_VisJac_Blasius</GitBranch>
            <GitSHA1>02c5e1135864cf898ba64b679825cd1f2d29f4b9</GitSHA1>
            <Hostname>zgyan-ThinkPad-X1-Carbon-6th</Hostname>
            <NektarVersion>4.5.0</NektarVersion>
            <Timestamp>11-Mar-2020 19:57:39</Timestamp>
        </Provenance>
        <NekMeshCommandLine>2_2.msh 2_2.xml </NekMeshCommandLine>
    </Metadata>

    <EXPANSIONS>
        <E COMPOSITE="C[11]" NUMMODES="10" TYPE="MODIFIED" FIELDS="rho,rhou,rhov,E" />
    </EXPANSIONS>
    <CONDITIONS>
        <PARAMETERS>
            <P> TimeStep              = 0.00001                          </P>
            <P> FinTime               = 0.01                           </P>
            <P> IO_InfoSteps          = 100                             </P>
            <P> GasConstant           = 287.058                       </P>
            <P> Gamma                 = 1.4                           </P>
            <P> pInf                  = 101325                        </P>
            <P> rhoInf                = 1.225                         </P>
            <P> Mach                 = 0.1                           </P>
            <P> cInf                   = sqrt(Gamma * pInf / rhoInf)   </P>
            <P> uInf                  = Mach*cInf                     </P>
            <P> vInf                  = 0.0                           </P>
            <P> Twall                 = 300.15                        </P>
            <P> T0                    = 0.8*Twall                     </P>
            <P> T1                    = 0.85*Twall                    </P>
            <P> Re                    = 100                           </P>
            <P> L                     = 1                             </P>
            <P> mu                    = rhoInf * L * uInf / Re        </P>
            <P> Pr                    = 0.72                          </P>
            <P> Cv                    = GasConstant/(Gamma-1)         </P>
            <P> Cp                    = (Gamma*GasConstant)/(Gamma-1) </P>

        </PARAMETERS>

        <SOLVERINFO>
            <I PROPERTY="EQType"                VALUE="NavierStokesCFE"     />
            <I PROPERTY="Projection"            VALUE="DisContinuous"       />
            <I PROPERTY="AdvectionType"         VALUE="WeakDG"              />
            <I PROPERTY="DiffusionType"         VALUE="InteriorPenalty"     />
            <I PROPERTY="UpwindType"            VALUE="Roe"                 />
            <I PROPERTY="ViscosityType"         VALUE="Constant"            />
            <I PROPERTY="ViscousTraceFlux" VALUE="AverageOfNormalFluxes" />
        </SOLVERINFO>

        <TIMEINTEGRATIONSCHEME>
            <METHOD> RungeKutta </METHOD>
            <ORDER> 1 </ORDER>
        </TIMEINTEGRATIONSCHEME>


        <!-- Reference values: the redesign reads gas transport properties
            from here, not from <PARAMETERS>. Gamma and GasConstant belong to
            the equation of state below. Anything omitted here silently falls
            back to a built-in default and only warns, so every value the case
            depends on is stated explicitly. These reproduce the legacy
            properties: mu = rhoInf*L*uInf/Re with Re = 100. -->
        <ReferenceValues>
            <Viscosity>   mu     </Viscosity>
            <Prandtl>     Pr     </Prandtl>
            <Density>     rhoInf </Density>
            <Pressure>    pInf   </Pressure>
        </ReferenceValues>

        <EquationOfState>
            <Type> IdealGas </Type>
            <Parameters>
                <Gamma>       Gamma       </Gamma>
                <GasConstant> GasConstant </GasConstant>
            </Parameters>
        </EquationOfState>

        <VARIABLES>
            <V ID="0"> rho  </V>
            <V ID="1"> rhou </V>
            <V ID="2"> rhov </V>
            <V ID="3"> E    </V>
        </VARIABLES>

        <BOUNDARYREGIONS>
            <B ID="0"> C[7] </B>
            <B ID="1"> C[8] </B>
            <B ID="2"> C[9] </B>
            <B ID="3"> C[10] </B>
        </BOUNDARYREGIONS>

        <BOUNDARYCONDITIONS>

            <REGION REF="0">
                <D VAR="rho"  USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="rhou" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="rhov" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="E"    USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
            </REGION>

            <REGION REF="2">
                <D VAR="rho"  VALUE="pInf/(GasConstant*T1)" />
                <D VAR="rhou" VALUE="pInf/(GasConstant*T1)*uInf" />
                <D VAR="rhov" VALUE="0"/>
                <D VAR="E"    VALUE="pInf/(GasConstant*T1)*(Cv*T1+0.5 * uInf * uInf)" />
            </REGION>
            <!--       Period -->
            <REGION REF="1">
                <P VAR="rho"  VALUE="[3]" />
                <P VAR="rhou" VALUE="[3]" />
                <P VAR="rhov" VALUE="[3]" />
                <P VAR="E"    VALUE="[3]" />
            </REGION>
            <REGION REF="3">
                <P VAR="rho"  VALUE="[1]" />
                <P VAR="rhou" VALUE="[1]" />
                <P VAR="rhov" VALUE="[1]" />
                <P VAR="E"    VALUE="[1]" />
            </REGION>
        </BOUNDARYCONDITIONS>

        <FUNCTION NAME="InitialConditions">
            <E VAR="rho"  VALUE="pInf/(GasConstant*(T0+y/L*(T1-T0)+y/L*(1.0-y/L)*Pr*uInf*uInf/(2.0*Cp)))" />
            <E VAR="rhou" VALUE="pInf/(GasConstant*(T0+y/L*(T1-T0)+y/L*(1.0-y/L)*Pr*uInf*uInf/(2.0*Cp)))*y/L*uInf" />
            <E VAR="rhov" VALUE="0.0" />
            <E VAR="E"    VALUE="pInf/(GasConstant*(T0+y/L*(T1-T0)+y/L*(1.0-y/L)*Pr*uInf*uInf/(2.0*Cp)))*(Cv*(T0+y/L*(T1-T0)+y/L*(1.0-y/L)*Pr*uInf*uInf/(2.0*Cp))+0.5*y/L*uInf*y/L*uInf)" />
        </FUNCTION>

        <FUNCTION NAME="ExactSolution">
            <E VAR="rho"  VALUE="pInf/(GasConstant*(T0+y/L*(T1-T0)+y/L*(1.0-y/L)*Pr*uInf*uInf/(2.0*Cp)))" />
            <E VAR="rhou" VALUE="pInf/(GasConstant*(T0+y/L*(T1-T0)+y/L*(1.0-y/L)*Pr*uInf*uInf/(2.0*Cp)))*y/L*uInf" />
            <E VAR="rhov" VALUE="0.0" />
            <E VAR="E"    VALUE="pInf/(GasConstant*(T0+y/L*(T1-T0)+y/L*(1.0-y/L)*Pr*uInf*uInf/(2.0*Cp)))*(Cv*(T0+y/L*(T1-T0)+y/L*(1.0-y/L)*Pr*uInf*uInf/(2.0*Cp))+0.5*y/L*uInf*y/L*uInf)" />
        </FUNCTION>
    </CONDITIONS>
</NEKTAR>
