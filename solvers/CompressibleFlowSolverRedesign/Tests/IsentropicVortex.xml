    <EXPANSIONS>
        <E COMPOSITE="C[601]" NUMMODES="4" FIELDS="rho,rhou,rhov,E" TYPE="MODIFIED" />
    </EXPANSIONS>

    <CONDITIONS>

        <PARAMETERS>
            <P> GammaDim        = 1.4               </P>
            <P> TimeStep        = 0.001             </P>
            <P> T               = 0.1               </P>
            <P> NumSteps        = T/TimeStep        </P>
            <P> Beta = 5.0 </P>
            <P> U0   = 1.0 </P>
            <P> V0   = 0.5 </P>
            <P> X0   = 5.0 </P>
            <P> Y0   = 0.0 </P>
            <!-- constant factor -->
            <P> fac = 1/(16*GammaDim*PI^2) </P>

        </PARAMETERS>

        <SOLVERINFO>
            <I PROPERTY="EQType"                VALUE="EulerCFE"            />
            <I PROPERTY="Projection"            VALUE="DisContinuous"       />
            <I PROPERTY="AdvectionType"         VALUE="WeakDG"              />
            <I PROPERTY="UpwindType"            VALUE="LaxFriedrichs"       />
        </SOLVERINFO>

        <TIMEINTEGRATIONSCHEME>
            <METHOD> RungeKutta </METHOD>
            <ORDER> 4 </ORDER>
        </TIMEINTEGRATIONSCHEME>


        <EquationOfState>
            <Type> IdealGas </Type>
            <Parameters>
                <Gamma>       GammaDim </Gamma>
                <GasConstant> 287      </GasConstant>
            </Parameters>
        </EquationOfState>

        <VARIABLES>
            <V ID="0"> rho  </V>
            <V ID="1"> rhou </V>
            <V ID="2"> rhov </V>
            <V ID="3"> E    </V>
        </VARIABLES>

        <BOUNDARYREGIONS>
            <B ID="0"> C[401] </B>
            <B ID="1"> C[402] </B>
            <B ID="2"> C[403] </B>
            <B ID="3"> C[404] </B>

        </BOUNDARYREGIONS>

        <BOUNDARYCONDITIONS>
            <REGION REF="0">
                <P VAR="rho" VALUE="[1]" />
                <P VAR="rhou" VALUE="[1]" />
                <P VAR="rhov" VALUE="[1]" />
                <P VAR="E" VALUE="[1]" />
            </REGION>
            <REGION REF="1">
                <P VAR="rho" VALUE="[0]" />
                <P VAR="rhou" VALUE="[0]" />
                <P VAR="rhov" VALUE="[0]" />
                <P VAR="E" VALUE="[0]" />
            </REGION>
            <REGION REF="2">
                <P VAR="rho" VALUE="[3]" />
                <P VAR="rhou" VALUE="[3]" />
                <P VAR="rhov" VALUE="[3]" />
                <P VAR="E" VALUE="[3]" />
            </REGION>
            <REGION REF="3">
                <P VAR="rho" VALUE="[2]" />
                <P VAR="rhou" VALUE="[2]" />
                <P VAR="rhov" VALUE="[2]" />
                <P VAR="E" VALUE="[2]" />
            </REGION>

        </BOUNDARYCONDITIONS>

        <FUNCTION NAME="InitialConditions">

            <E VAR="rho"
                VALUE="
                (1 - (GammaDim-1)*(Beta*exp(1 - ((x-X0)^2 + (y-Y0)^2)))^2 * fac)^(1/(GammaDim-1))
                " />

            <E VAR="rhou"
                VALUE="
                (1 - (GammaDim-1)*(Beta*exp(1 - ((x-X0)^2 + (y-Y0)^2)))^2 * fac)^(1/(GammaDim-1))
                *
                (U0 - (Beta*exp(1 - ((x-X0)^2 + (y-Y0)^2)))*(y-Y0)/(2*PI))
                " />

            <E VAR="rhov"
                VALUE="
                (1 - (GammaDim-1)*(Beta*exp(1 - ((x-X0)^2 + (y-Y0)^2)))^2 * fac)^(1/(GammaDim-1))
                *
                ( V0 + (Beta*exp(1 - ((x-X0)^2 + (y-Y0)^2)))*(x-X0)/(2*PI) )
                " />

            <E VAR="E"
                VALUE="
                ((1 - (GammaDim-1)*(Beta*exp(1 - ((x-X0)^2 + (y-Y0)^2)))^2 * fac)^(GammaDim/(GammaDim-1)))/(GammaDim-1)
                + 0.5
                * (1 - (GammaDim-1)*(Beta*exp(1 - ((x-X0)^2 + (y-Y0)^2)))^2 * fac)^(1/(GammaDim-1))
                * (
                ( U0 - (Beta*exp(1 - ((x-X0)^2 + (y-Y0)^2)))*(y-Y0)/(2*PI) )^2
                + ( V0 + (Beta*exp(1 - ((x-X0)^2 + (y-Y0)^2)))*(x-X0)/(2*PI) )^2
                )
                " />

        </FUNCTION>

        <FUNCTION NAME="ExactSolution">

            <E VAR="rho"
                VALUE="
                (1 - (GammaDim-1)*(Beta*exp(1 - ((x-5.1)^2 + (y-0.05)^2)))^2 * fac)^(1/(GammaDim-1))
                " />

            <E VAR="rhou"
                VALUE="
                (1 - (GammaDim-1)*(Beta*exp(1 - ((x-5.1)^2 + (y-0.05)^2)))^2 * fac)^(1/(GammaDim-1))
                *
                ( U0 - (Beta*exp(1 - ((x-5.1)^2 + (y-0.05)^2)))*(y-0.05)/(2*PI) )
                " />

            <E VAR="rhov"
                VALUE="
                (1 - (GammaDim-1)*(Beta*exp(1 - ((x-5.1)^2 + (y-0.05)^2)))^2 * fac)^(1/(GammaDim-1))
                *
                ( V0 + (Beta*exp(1 - ((x-5.1)^2 + (y-0.05)^2)))*(x-5.1)/(2*PI) )
                " />

            <E VAR="E"
                VALUE="
                ((1 - (GammaDim-1)*(Beta*exp(1 - ((x-5.1)^2 + (y-0.05)^2)))^2 * fac)^(GammaDim/(GammaDim-1)))/(GammaDim-1)
                + 0.5
                * (1 - (GammaDim-1)*(Beta*exp(1 - ((x-5.1)^2 + (y-0.05)^2)))^2 * fac)^(1/(GammaDim-1))
                * (
                ( U0 - (Beta*exp(1 - ((x-5.1)^2 + (y-0.05)^2)))*(y-0.05)/(2*PI) )^2
                + ( V0 + (Beta*exp(1 - ((x-5.1)^2 + (y-0.05)^2)))*(x-5.1)/(2*PI) )^2
                )
                " />
        </FUNCTION>
