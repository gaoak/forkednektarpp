<?xml version="1.0" encoding="utf-8"?>
<!-- Curved-but-affine mesh of six tetrahedra (Tet6_Box_Curved.xml): every edge carries collinear curve points, so the
    elements take the deformed paths and must reproduce the affine results.
    Taylor-Green-type initial field on the box split into six tetrahedra (read from Tet6_Box_Curved.xml), P3 orthogonal basis on
    Gauss points, adiabatic walls on all six faces: the average-of-normal-fluxes viscous trace flux. -->
<NEKTAR>
    <EXPANSIONS>
        <E COMPOSITE="C[0]" NUMMODES="4" FIELDS="rho,rhou,rhov,rhow,E" TYPE="ORTHOGONAL" />
    </EXPANSIONS>
    <CONDITIONS>
        <SOLVERINFO>
            <I PROPERTY="EQType"                VALUE="NavierStokesCFE"     />
            <I PROPERTY="Projection"            VALUE="DisContinuous"       />
            <I PROPERTY="AdvectionType"         VALUE="WeakDG"              />
            <I PROPERTY="DiffusionType"         VALUE="InteriorPenalty"    />
            <I PROPERTY="UpwindType"            VALUE="Roe"                />
            <I PROPERTY="ProblemType"           VALUE="General"             />
            <I PROPERTY="ViscosityType"         VALUE="Constant"            />
            <I PROPERTY="ViscousTraceFlux"      VALUE="AverageOfNormalFluxes" />
        </SOLVERINFO>

        <PARAMETERS>
            <P> GammaDim               = 1.4                                 </P>
            <P> Ma                    = 0.1                                     </P>
            <P> ReRef                 = 1600                                    </P>
            <P> GasConstantDim        = 287.058                                 </P>

            <P> rhoDim                = 1.225                                   </P>
            <P> TDim                  = 288.15                                  </P>
            <P> pDim                  = rhoDim*GasConstantDim*TDim              </P>


            <P> soundSpdDim           = sqrt(GammaDim*pDim/rhoDim)                 </P>
            <P> L                     = 1.0                                     </P>

            <P> velMagnDim            = Ma*soundSpdDim                          </P>
            <P> uDim                  = velMagnDim                             </P>
            <P> vDim                  = 0                                       </P>
            <P> wDim                  = 0                                     </P>

            <P> Re0                   = ReRef/L                                 </P>
            <P> rhoInf                = rhoDim/rhoDim                           </P>
            <P> uInf                  = uDim/velMagnDim                         </P>
            <P> vInf                  = vDim/velMagnDim                         </P>
            <P> wInf                  = wDim/velMagnDim                         </P>
            <P> pInf                  = pDim/(rhoDim*velMagnDim*velMagnDim)     </P>
            <P> mu                    = 1/Re0                                   </P>
            <P> TimeStep       = 0.0001    </P>
            <P> NumSteps       = 10     </P>
        </PARAMETERS>

        <TIMEINTEGRATIONSCHEME>
            <METHOD> RungeKutta </METHOD>
            <ORDER> 1 </ORDER>
        </TIMEINTEGRATIONSCHEME>

        <EquationOfState>
            <Type> IdealGas </Type>
            <Parameters>
                <Gamma>       GammaDim </Gamma>
                <GasConstant> GasConstantDim*TDim/(velMagnDim*velMagnDim) </GasConstant>
            </Parameters>
        </EquationOfState>

        <ReferenceValues>
            <Viscosity>     1/Re0                               </Viscosity>
            <Pressure>      pDim/(rhoDim*velMagnDim*velMagnDim) </Pressure>
            <Density>       rhoInf                              </Density>
            <Temperature>   TDim                                </Temperature>
            <Tsutherland>   110                                 </Tsutherland>
            <Prandtl>       0.72                                </Prandtl>
            <!--ThermalConductivity>    xxx     </ThermalConductivity-->
        </ReferenceValues>

        <VARIABLES>
            <V ID="0"> rho  </V>
            <V ID="1"> rhou </V>
            <V ID="2"> rhov </V>
            <V ID="3"> rhow </V>
            <V ID="4"> E    </V>
        </VARIABLES>

        <BOUNDARYREGIONS>
            <B ID="0"> C[1] </B>
            <B ID="1"> C[2] </B>
            <B ID="2"> C[3] </B>
            <B ID="3"> C[4] </B>
            <B ID="4"> C[5] </B>
            <B ID="5"> C[6] </B>
        </BOUNDARYREGIONS>

        <BOUNDARYCONDITIONS>
            <REGION REF="0">
                <D VAR="rho" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="rhou" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="rhov" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="rhow" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="E" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
            </REGION>
            <REGION REF="1">
                <D VAR="rho" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="rhou" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="rhov" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="rhow" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="E" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
            </REGION>
            <REGION REF="2">
                <D VAR="rho" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="rhou" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="rhov" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="rhow" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="E" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
            </REGION>
            <REGION REF="3">
                <D VAR="rho" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="rhou" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="rhov" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="rhow" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="E" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
            </REGION>
            <REGION REF="4">
                <D VAR="rho" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="rhou" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="rhov" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="rhow" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="E" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
            </REGION>
            <REGION REF="5">
                <D VAR="rho" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="rhou" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="rhov" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="rhow" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
                <D VAR="E" USERDEFINEDTYPE="WallAdiabatic" VALUE="0" />
            </REGION>
        </BOUNDARYCONDITIONS>

        <FUNCTION NAME="InitialConditions">
            <E VAR="rho" VALUE="rhoInf" />
            <E VAR="rhou" VALUE="rhoInf * uInf * sin(x/L) * cos(y/L) * cos(z/L)" />
            <E VAR="rhov" VALUE="-rhoInf * uInf * cos(x/L) * sin(y/L) * cos(z/L)" />
            <E VAR="rhow" VALUE="0" />
            <E VAR="E" VALUE="
                (
                pInf
                + (rhoInf * uInf * uInf / 16.0)
                * (cos(2*x/L) + cos(2*y/L))
                * (cos(2*z/L) + 2.0)
                ) / (GammaDim - 1.0)
                + 0.5 * rhoInf * (
                (uInf * sin(x/L) * cos(y/L) * cos(z/L))
                * (uInf * sin(x/L) * cos(y/L) * cos(z/L))
                +
                (-uInf * cos(x/L) * sin(y/L) * cos(z/L))
                * (-uInf * cos(x/L) * sin(y/L) * cos(z/L))
                )
                " />
        </FUNCTION>

        <FUNCTION NAME="ExactSolution">
            <E VAR="rho" VALUE="rhoInf" />
            <E VAR="rhou" VALUE="
                rhoInf * uInf
                * sin(x/L) * cos(y/L) * cos(z/L)
                * exp(-3.0 * mu * t)
                " />
            <E VAR="rhov" VALUE="
                -rhoInf * uInf
                * cos(x/L) * sin(y/L) * cos(z/L)
                * exp(-3.0 * mu * t)
                " />
            <E VAR="rhow" VALUE="0" />
            <E VAR="E" VALUE="
                (
                pInf
                + (rhoInf * uInf * uInf / 16.0)
                * (cos(2*x/L) + cos(2*y/L))
                * (cos(2*z/L) + 2.0)
                * exp(-6.0 * mu * t)
                ) / (GammaDim - 1.0)
                + 0.5 * rhoInf * (
                (
                uInf * sin(x/L) * cos(y/L) * cos(z/L)
                * exp(-3.0 * mu * t)
                )
                *
                (
                uInf * sin(x/L) * cos(y/L) * cos(z/L)
                * exp(-3.0 * mu * t)
                )
                +
                (
                -uInf * cos(x/L) * sin(y/L) * cos(z/L)
                * exp(-3.0 * mu * t)
                )
                *
                (
                -uInf * cos(x/L) * sin(y/L) * cos(z/L)
                * exp(-3.0 * mu * t)
                )
                )
                " />
        </FUNCTION>
    </CONDITIONS>
</NEKTAR>
