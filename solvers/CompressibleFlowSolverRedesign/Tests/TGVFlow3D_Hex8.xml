    <EXPANSIONS>
        <E COMPOSITE="C[7]" NUMMODES="7" FIELDS="rho,rhou,rhov,rhow,E" TYPE="MODIFIED" />
    </EXPANSIONS>

    <CONDITIONS>
        <SOLVERINFO>
            <I PROPERTY="EQType"                VALUE="NavierStokesCFE"     />
            <I PROPERTY="Projection"            VALUE="DisContinuous"       />
            <I PROPERTY="AdvectionType"         VALUE="WeakDG"              />
            <I PROPERTY="DiffusionType"         VALUE="InteriorPenalty"               />
            <I PROPERTY="UpwindType"            VALUE="Roe"                />
            <I PROPERTY="ProblemType"           VALUE="General"             />
            <I PROPERTY="ViscosityType"         VALUE="Constant"            />
        </SOLVERINFO>

        <PARAMETERS>
            <P> Gamma                 = 1.4                                     </P>
            <P> Ma                    = 0.1                                     </P>
            <P> ReRef                 = 1600                                    </P>
            <P> Pr                    = 0.72                                    </P>
            <P> GasConstantDim        = 287.058                                 </P>

            <P> rhoDim                = 1.225                                   </P>
            <P> TDim                  = 288.15                                  </P>
            <P> Tref                  = TDim                                    </P>
            <P> pDim                  = rhoDim*GasConstantDim*TDim              </P>

            <P> Alpha_deg             = 0                                    </P>
            <P> Alpha_rad             = Alpha_deg*PI/180                        </P>

            <P> soundSpdDim           = sqrt(Gamma*pDim/rhoDim)                 </P>
            <P> L                     = 1.0                                     </P>

            <P> velMagnDim            = Ma*soundSpdDim                          </P>
            <P> uDim                  = velMagnDim                             </P>
            <P> vDim                  = 0                                       </P>
            <P> wDim                  = 0                                     </P>
            <P> muDim                 = rhoDim*uDim*L/ReRef                     </P>

            <P> Re0                   = ReRef/L                                 </P>
            <P> rhoInf                = rhoDim/rhoDim                           </P>
            <P> uInf                  = uDim/velMagnDim                         </P>
            <P> vInf                  = vDim/velMagnDim                         </P>
            <P> wInf                  = wDim/velMagnDim                         </P>
            <P> pInf                  = pDim/(rhoDim*velMagnDim*velMagnDim)     </P>
            <P> mu                    = 1/Re0                                   </P>
            <P> GasConstant           = GasConstantDim*TDim/(velMagnDim*velMagnDim)</P>

            <P> TimeStep       = 0.0001    </P>
            <P> NumSteps       = 10     </P>
        </PARAMETERS>

        <TIMEINTEGRATIONSCHEME>
            <METHOD> RungeKutta </METHOD>
            <ORDER> 1 </ORDER>
        </TIMEINTEGRATIONSCHEME>

        <VARIABLES>
            <V ID="0"> rho  </V>
            <V ID="1"> rhou </V>
            <V ID="2"> rhov </V>
            <V ID="3"> rhow </V>
            <V ID="4"> E    </V>
        </VARIABLES>

        <BOUNDARYREGIONS>
            <B ID="0"> C[1] </B>
            <B ID="1"> C[3] </B>
            <B ID="2"> C[2] </B>
            <B ID="3"> C[4] </B>
            <B ID="4"> C[5] </B>
            <B ID="5"> C[6] </B>
        </BOUNDARYREGIONS>

        <BOUNDARYCONDITIONS>
            <REGION REF="0">
                <P VAR="rho" VALUE="[2]" />
                <P VAR="rhou" VALUE="[2]" />
                <P VAR="rhov" VALUE="[2]" />
                <P VAR="rhow" VALUE="[2]" />
                <P VAR="E" VALUE="[2]" />
            </REGION>
            <REGION REF="1">
                <P VAR="rho" VALUE="[3]" />
                <P VAR="rhou" VALUE="[3]" />
                <P VAR="rhov" VALUE="[3]" />
                <P VAR="rhow" VALUE="[3]" />
                <P VAR="E" VALUE="[3]" />
            </REGION>
            <REGION REF="2">
                <P VAR="rho" VALUE="[0]" />
                <P VAR="rhou" VALUE="[0]" />
                <P VAR="rhov" VALUE="[0]" />
                <P VAR="rhow" VALUE="[0]" />
                <P VAR="E" VALUE="[0]" />
            </REGION>
            <REGION REF="3">
                <P VAR="rho" VALUE="[1]" />
                <P VAR="rhou" VALUE="[1]" />
                <P VAR="rhov" VALUE="[1]" />
                <P VAR="rhow" VALUE="[1]" />
                <P VAR="E" VALUE="[1]" />
            </REGION>
            <REGION REF="4">
                <P VAR="rho" VALUE="[5]" />
                <P VAR="rhou" VALUE="[5]" />
                <P VAR="rhov" VALUE="[5]" />
                <P VAR="rhow" VALUE="[5]" />
                <P VAR="E" VALUE="[5]" />
            </REGION>
            <REGION REF="5">
                <P VAR="rho" VALUE="[4]" />
                <P VAR="rhou" VALUE="[4]" />
                <P VAR="rhov" VALUE="[4]" />
                <P VAR="rhow" VALUE="[4]" />
                <P VAR="E" VALUE="[4]" />
            </REGION>
        </BOUNDARYCONDITIONS>

        <FUNCTION NAME="InitialConditions">
            <E VAR="rho" VALUE="rhoInf" />
            <E VAR="rhou" VALUE="rhoInf * uInf * sin(x/L) * cos(y/L) * cos(z/L)" />
            <E VAR="rhov" VALUE="-rhoInf * uInf * cos(x/L) * sin(y/L) * cos(z/L)" />
            <E VAR="rhow" VALUE="0" />
            <E VAR="E" VALUE="
                (
                pInf
                + (rhoInf * uInf * uInf / 16.0)
                * (cos(2*x/L) + cos(2*y/L))
                * (cos(2*z/L) + 2.0)
                ) / (Gamma - 1.0)
                + 0.5 * rhoInf * (
                (uInf * sin(x/L) * cos(y/L) * cos(z/L))
                * (uInf * sin(x/L) * cos(y/L) * cos(z/L))
                +
                (-uInf * cos(x/L) * sin(y/L) * cos(z/L))
                * (-uInf * cos(x/L) * sin(y/L) * cos(z/L))
                )
                " />
        </FUNCTION>

        <FUNCTION NAME="ExactSolution">
            <E VAR="rho" VALUE="rhoInf" />
            <E VAR="rhou" VALUE="
                rhoInf * uInf
                * sin(x/L) * cos(y/L) * cos(z/L)
                * exp(-3.0 * mu * t)
                " />
            <E VAR="rhov" VALUE="
                -rhoInf * uInf
                * cos(x/L) * sin(y/L) * cos(z/L)
                * exp(-3.0 * mu * t)
                " />
            <E VAR="rhow" VALUE="0" />
            <E VAR="E" VALUE="
                (
                pInf
                + (rhoInf * uInf * uInf / 16.0)
                * (cos(2*x/L) + cos(2*y/L))
                * (cos(2*z/L) + 2.0)
                * exp(-6.0 * mu * t)
                ) / (Gamma - 1.0)
                + 0.5 * rhoInf * (
                (
                uInf * sin(x/L) * cos(y/L) * cos(z/L)
                * exp(-3.0 * mu * t)
                )
                *
                (
                uInf * sin(x/L) * cos(y/L) * cos(z/L)
                * exp(-3.0 * mu * t)
                )
                +
                (
                -uInf * cos(x/L) * sin(y/L) * cos(z/L)
                * exp(-3.0 * mu * t)
                )
                *
                (
                -uInf * cos(x/L) * sin(y/L) * cos(z/L)
                * exp(-3.0 * mu * t)
                )
                )
                " />
        </FUNCTION>
    </CONDITIONS>
