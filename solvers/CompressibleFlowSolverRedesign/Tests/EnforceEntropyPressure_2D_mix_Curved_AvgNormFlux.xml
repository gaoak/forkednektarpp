<?xml version="1.0" encoding="utf-8" ?>
<!-- EnforceEntropyPressure_2D_mix with the average-of-normal-fluxes viscous trace flux and every edge given a
    three-point curve whose points lie on the straight edge: the four triangles and two quadrilaterals are flagged
    deformed while the geometry stays affine, so the deformed paths, each element's own normals on its traces among
    them, must reproduce the affine results. -->
<NEKTAR>
    <GEOMETRY DIM="2" SPACE="2">
        <VERTEX>
            <V ID="0">0.00000000e+00 0.00000000e+00 0.00000000e+00</V>
            <V ID="1">1.00000000e+00 0.00000000e+00 0.00000000e+00</V>
            <V ID="2">1.00000000e+00 1.00000000e+00 0.00000000e+00</V>
            <V ID="3">0.00000000e+00 1.00000000e+00 0.00000000e+00</V>
            <V ID="4">2.00000000e+00 0.00000000e+00 0.00000000e+00</V>
            <V ID="5">2.00000000e+00 1.00000000e+00 0.00000000e+00</V>
            <V ID="6">1.00000000e+00 2.00000000e+00 0.00000000e+00</V>
            <V ID="7">0.00000000e+00 2.00000000e+00 0.00000000e+00</V>
            <V ID="8">2.00000000e+00 2.00000000e+00 0.00000000e+00</V>
        </VERTEX>
        <EDGE>
            <E ID="0">0 1</E>
            <E ID="1">1 2</E>
            <E ID="2">2 3</E>
            <E ID="3">3 0</E>
            <E ID="4">1 4</E>
            <E ID="5">4 5</E>
            <E ID="6">5 2</E>
            <E ID="7">2 6</E>
            <E ID="8">6 7</E>
            <E ID="9">7 2</E>
            <E ID="10">2 8</E>
            <E ID="11">8 6</E>
            <E ID="12">5 8</E>
            <E ID="13">7 3</E>
        </EDGE>
        <ELEMENT>
            <T ID="2">7 8 9</T>
            <T ID="3">10 11 7</T>
            <T ID="4">6 12 10</T>
            <T ID="5">9 13 2</T>
            <Q ID="0">0 1 2 3</Q>
            <Q ID="1">4 5 6 1</Q>
        </ELEMENT>
        <CURVED>
            <E ID="0" EDGEID="0" NUMPOINTS="3" TYPE="PolyEvenlySpaced">0.00000000e+00 0.00000000e+00 0.00000000e+00   5.00000000e-01 0.00000000e+00 0.00000000e+00   1.00000000e+00 0.00000000e+00 0.00000000e+00</E>
            <E ID="1" EDGEID="1" NUMPOINTS="3" TYPE="PolyEvenlySpaced">1.00000000e+00 0.00000000e+00 0.00000000e+00   1.00000000e+00 5.00000000e-01 0.00000000e+00   1.00000000e+00 1.00000000e+00 0.00000000e+00</E>
            <E ID="2" EDGEID="2" NUMPOINTS="3" TYPE="PolyEvenlySpaced">1.00000000e+00 1.00000000e+00 0.00000000e+00   5.00000000e-01 1.00000000e+00 0.00000000e+00   0.00000000e+00 1.00000000e+00 0.00000000e+00</E>
            <E ID="3" EDGEID="3" NUMPOINTS="3" TYPE="PolyEvenlySpaced">0.00000000e+00 1.00000000e+00 0.00000000e+00   0.00000000e+00 5.00000000e-01 0.00000000e+00   0.00000000e+00 0.00000000e+00 0.00000000e+00</E>
            <E ID="4" EDGEID="4" NUMPOINTS="3" TYPE="PolyEvenlySpaced">1.00000000e+00 0.00000000e+00 0.00000000e+00   1.50000000e+00 0.00000000e+00 0.00000000e+00   2.00000000e+00 0.00000000e+00 0.00000000e+00</E>
            <E ID="5" EDGEID="5" NUMPOINTS="3" TYPE="PolyEvenlySpaced">2.00000000e+00 0.00000000e+00 0.00000000e+00   2.00000000e+00 5.00000000e-01 0.00000000e+00   2.00000000e+00 1.00000000e+00 0.00000000e+00</E>
            <E ID="6" EDGEID="6" NUMPOINTS="3" TYPE="PolyEvenlySpaced">2.00000000e+00 1.00000000e+00 0.00000000e+00   1.50000000e+00 1.00000000e+00 0.00000000e+00   1.00000000e+00 1.00000000e+00 0.00000000e+00</E>
            <E ID="7" EDGEID="7" NUMPOINTS="3" TYPE="PolyEvenlySpaced">1.00000000e+00 1.00000000e+00 0.00000000e+00   1.00000000e+00 1.50000000e+00 0.00000000e+00   1.00000000e+00 2.00000000e+00 0.00000000e+00</E>
            <E ID="8" EDGEID="8" NUMPOINTS="3" TYPE="PolyEvenlySpaced">1.00000000e+00 2.00000000e+00 0.00000000e+00   5.00000000e-01 2.00000000e+00 0.00000000e+00   0.00000000e+00 2.00000000e+00 0.00000000e+00</E>
            <E ID="9" EDGEID="9" NUMPOINTS="3" TYPE="PolyEvenlySpaced">0.00000000e+00 2.00000000e+00 0.00000000e+00   5.00000000e-01 1.50000000e+00 0.00000000e+00   1.00000000e+00 1.00000000e+00 0.00000000e+00</E>
            <E ID="10" EDGEID="10" NUMPOINTS="3" TYPE="PolyEvenlySpaced">1.00000000e+00 1.00000000e+00 0.00000000e+00   1.50000000e+00 1.50000000e+00 0.00000000e+00   2.00000000e+00 2.00000000e+00 0.00000000e+00</E>
            <E ID="11" EDGEID="11" NUMPOINTS="3" TYPE="PolyEvenlySpaced">2.00000000e+00 2.00000000e+00 0.00000000e+00   1.50000000e+00 2.00000000e+00 0.00000000e+00   1.00000000e+00 2.00000000e+00 0.00000000e+00</E>
            <E ID="12" EDGEID="12" NUMPOINTS="3" TYPE="PolyEvenlySpaced">2.00000000e+00 1.00000000e+00 0.00000000e+00   2.00000000e+00 1.50000000e+00 0.00000000e+00   2.00000000e+00 2.00000000e+00 0.00000000e+00</E>
            <E ID="13" EDGEID="13" NUMPOINTS="3" TYPE="PolyEvenlySpaced">0.00000000e+00 2.00000000e+00 0.00000000e+00   0.00000000e+00 1.50000000e+00 0.00000000e+00   0.00000000e+00 1.00000000e+00 0.00000000e+00</E>
        </CURVED>
        <COMPOSITE>
            <C ID="1"> E[13,3] </C>
            <C ID="2"> E[5,12] </C>
            <C ID="3"> E[0,4] </C>
            <C ID="4"> E[8,11] </C>
            <C ID="100"> Q[0-1] </C>
            <C ID="101"> T[2-5] </C>
        </COMPOSITE>
        <DOMAIN> C[100-101] </DOMAIN>
    </GEOMETRY>

    <EXPANSIONS>
        <E COMPOSITE="C[100,101]" NUMMODES="4" TYPE="MODIFIED" FIELDS="rho,rhou,rhov,E" />
    </EXPANSIONS>

    <CONDITIONS>
        <PARAMETERS>
            <P> TimeStep            = 0.001                         </P>
            <P> NumSteps            = 100                           </P>
            <P> IO_InfoSteps        = 100                           </P>
            <P> IO_CFLSteps         = 100                           </P>
            <!-- Fluid properties. Duplicated in EquationOfState and
                ReferenceValues below, which is where the redesign reads them;
                legacy reads them from here. -->
            <P> Gamma               = 1.4                           </P>
            <P> Pr                  = 0.72                          </P>
            <P> Mach                = 0.8                           </P>
            <P> Re                  = 1.0e6                         </P>
            <P> GasConstant         = 1/(Gamma*Mach*Mach)            </P>
            <P> mu                  = 1.0/Re                        </P>
            <!-- Boundary condition parameters -->
            <P> rhoInf              = 1.0                           </P>
            <P> TInf                = 1.0                           </P>
            <P> pInf                = rhoInf*GasConstant*TInf        </P>
            <P> uInf                = 1.0                           </P>
            <P> vInf                = 0.0                           </P>
        </PARAMETERS>

        <SOLVERINFO>
            <I PROPERTY="EQType"                VALUE="NavierStokesCFE"     />
            <I PROPERTY="Projection"            VALUE="DisContinuous"       />
            <I PROPERTY="AdvectionType"         VALUE="WeakDG"              />
            <I PROPERTY="DiffusionType"         VALUE="InteriorPenalty"     />
            <I PROPERTY="UpwindType"            VALUE="Roe"                 />
            <I PROPERTY="ViscosityType"         VALUE="Constant"            />
            <I PROPERTY="ViscousTraceFlux"      VALUE="AverageOfNormalFluxes" />
        </SOLVERINFO>

        <TIMEINTEGRATIONSCHEME>
            <METHOD> RungeKutta </METHOD>
            <ORDER> 4 </ORDER>
        </TIMEINTEGRATIONSCHEME>

        <EquationOfState>
            <Type> IdealGas </Type>
            <Parameters>
                <Gamma>       Gamma       </Gamma>
                <GasConstant> GasConstant </GasConstant>
            </Parameters>
        </EquationOfState>

        <ReferenceValues>
            <Viscosity>   mu     </Viscosity>
            <Prandtl>     Pr     </Prandtl>
            <Density>     rhoInf </Density>
            <Pressure>    pInf   </Pressure>
        </ReferenceValues>

        <VARIABLES>
            <V ID="0"> rho  </V>
            <V ID="1"> rhou </V>
            <V ID="2"> rhov </V>
            <V ID="3"> E    </V>
        </VARIABLES>

        <BOUNDARYREGIONS>
            <B ID="0"> C[3] </B>    <!-- bottom, periodic with top -->
            <B ID="1"> C[1] </B>    <!-- inflow  -->
            <B ID="2"> C[2] </B>    <!-- outflow -->
            <B ID="3"> C[4] </B>    <!-- top, periodic with bottom -->
        </BOUNDARYREGIONS>

        <BOUNDARYCONDITIONS>
            <REGION REF="0">
                <P VAR="rho"  VALUE="[3]" />
                <P VAR="rhou" VALUE="[3]" />
                <P VAR="rhov" VALUE="[3]" />
                <P VAR="E"    VALUE="[3]" />
            </REGION>
            <REGION REF="3">
                <P VAR="rho"  VALUE="[0]" />
                <P VAR="rhou" VALUE="[0]" />
                <P VAR="rhov" VALUE="[0]" />
                <P VAR="E"    VALUE="[0]" />
            </REGION>
            <!-- The entropy inflow takes an ordinary conserved state: the
                energy slot really holds an energy. The outflow below puts a
                pressure in the same slot, which is its own convention. -->
            <REGION REF="1">
                <D VAR="rho"  USERDEFINEDTYPE="EnforceEntropyPressure" VALUE="rhoInf" />
                <D VAR="rhou" USERDEFINEDTYPE="EnforceEntropyPressure" VALUE="rhoInf*uInf" />
                <D VAR="rhov" USERDEFINEDTYPE="EnforceEntropyPressure" VALUE="rhoInf*vInf" />
                <D VAR="E"    USERDEFINEDTYPE="EnforceEntropyPressure" VALUE="pInf/(Gamma-1) + 0.5*rhoInf*(uInf*uInf + vInf*vInf)" />
            </REGION>
            <REGION REF="2">
                <D VAR="rho"  USERDEFINEDTYPE="PressureOutflow" VALUE="0" />
                <D VAR="rhou" USERDEFINEDTYPE="PressureOutflow" VALUE="0" />
                <D VAR="rhov" USERDEFINEDTYPE="PressureOutflow" VALUE="0" />
                <D VAR="E"    USERDEFINEDTYPE="PressureOutflow" VALUE="pInf" />
            </REGION>
        </BOUNDARYCONDITIONS>

        <!-- Perturbed away from the freestream on purpose. With a uniform
            initial state this condition and a plain Dirichlet at the same
            values give identical answers, so a uniform case cannot tell them
            apart; the bump makes the interior trace at the inflow differ from
            the prescribed state, which is what the Riemann and entropy
            algebra acts on. -->
        <FUNCTION NAME="InitialConditions">
            <E VAR="rho"  VALUE="rhoInf*(1.0 + 0.2*exp(-40.0*((x-0.5)*(x-0.5)+(y-0.5)*(y-0.5))))" />
            <E VAR="rhou" VALUE="rhoInf*uInf*(1.0 + 0.2*exp(-40.0*((x-0.5)*(x-0.5)+(y-0.5)*(y-0.5))))" />
            <E VAR="rhov" VALUE="rhoInf*vInf" />
            <E VAR="E"    VALUE="pInf/(Gamma-1) + 0.5*rhoInf*(uInf*uInf + vInf*vInf)" />
        </FUNCTION>
    </CONDITIONS>
</NEKTAR>
